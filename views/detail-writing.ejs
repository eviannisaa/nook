<%- include("partials/detail-styles") %>
<%- include("partials/note-body-styles") %>
<%- include("partials/actions-menu-styles") %>
<%
  const face = writing.mood ? moodFaces[writing.mood] : "";
  // catatan terkunci sampai ke halaman ini dalam bentuk terenkripsi, lalu
  // dibuka di browser dengan key-nya (public/js/note-crypto.js)
  const lockedNote = Boolean(writing.isEncrypted);
  // nama file PDF mengikuti judul dan tanggal catatan, misalnya hello-world-2026-09-30.pdf
  const pdfSlug = String(writing.title || "")
    .toLowerCase()
    .normalize("NFKD")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "")
    .slice(0, 60) || "note";
  const pdfDay = writing.date ? new Date(writing.date).toLocaleDateString("en-CA", { timeZone: "Asia/Jakarta" }) : "";
  const pdfName = pdfSlug + (pdfDay ? "-" + pdfDay : "") + ".pdf";
  // nilai untuk inline script: JSON dengan "<" yang di-escape, supaya judul
  // catatan tidak bisa menutup tag script
  const jsValue = (v) => JSON.stringify(v).replace(/</g, "\\u003c");
  // data yang dibutuhkan browser untuk membuka catatan: ciphertext-nya, atau
  // untuk catatan lama yang dulu dikunci di server, hanya penanda legacy
  // (catatan ini di-upgrade saat dibuka)
  const lockedPayload = lockedNote
    ? writing.encVersion
      ? { id: String(writing._id), content: writing.content, salt: writing.salt, iv: writing.iv }
      : { id: String(writing._id), legacy: true }
    : null;
%>
<style>
  /* bagian yang muncul atau hilang saat catatan terkunci dibuka: atribut
     hidden harus mengalahkan display bawaan elemennya */
  .detail-page [hidden] {
    display: none !important;
  }

  /* detail catatan: header halaman writing di atas, lalu satu card seperti
     di detail kontak, berisi baris tanggal / mood, judul catatan (gayanya
     seperti bulan di kalender) di bawah label catatan, dan isi catatan.
     Encrypt / decrypt ada di dekat delete, di luar card */
  /* garis kertas di sini dibuat lebih samar daripada di editor, supaya
     tidak mengganggu tulisan */
  .detail-card .note-body {
    --note-rule-color: color-mix(in srgb, var(--color-line) 38%, transparent);
  }

  /* judul diberi jarak yang cukup dari label di atasnya dan dari isi
     catatan di bawahnya */
  .detail-note-title {
    margin-bottom: 0.75rem;
    overflow-wrap: anywhere;
  }

  .detail-row-icon.is-face {
    font-size: 1.25rem;
    line-height: 1;
  }

  /* label catatan, dengan tanda "decrypted" di sampingnya saat terbuka */
  .detail-note-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.9rem;
    margin-bottom: 0.5rem;
  }

  /* actions di header tetap sebaris dengan judul. Jika ruangnya kurang,
     teks judul yang turun ke baris berikutnya, bukan actions-nya */
  .detail-page > .header {
    flex-wrap: nowrap;
  }

  .detail-header-text {
    min-width: 0;
  }

  .detail-page > .header .detail-actions {
    align-self: center;
    flex-shrink: 0;
  }

  /* actions di header sejajar dengan baris teks di bawah judul */
  .detail-page > .header .detail-actions {
    align-self: flex-end;
    padding-bottom: 0.3rem;
  }

  /* waktu terakhir diedit, ditampilkan samar di bawah tanggal */
  .detail-edited {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-comic);
    font-size: 0.8rem;
    color: var(--color-ink-soft);
  }

  @media (max-width: 639px) {
    .detail-edited {
      font-size: 0.7rem;
    }
  }

  /* keterangan status kunci, ditampilkan samar */
  .detail-lock-note {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-comic);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-ink-soft);
  }

  /* teks terkunci: kotak pucat berisi huruf acak yang tidak bisa dipilih,
     ditampilkan setinggi isinya */
  .detail-cipher {
    padding: 1rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    word-break: break-all;
    user-select: none;
    background-color: color-mix(in srgb, var(--color-paper-deep) 55%, var(--color-paper));
    border: 1.5px dashed color-mix(in srgb, var(--color-ink) 16%, var(--color-line));
    border-radius: 22px 18px 24px 16px / 16px 24px 18px 22px;
  }

  @media (max-width: 639px) {
    /* teks judul mendapat lebar minimal 10rem. Jika "Decrypt" dan Actions
       tidak muat di sampingnya, keduanya turun ke bawah judul, rata kanan */
    .detail-page > .header {
      flex-wrap: wrap;
      row-gap: 0.6rem;
    }

    .detail-header-text {
      flex: 1 1 10rem;
    }

    .detail-page > .header .detail-actions {
      gap: 0.35rem;
      margin-left: auto;
    }

    .detail-page > .header .detail-actions {
      padding-bottom: 0.15rem;
    }

    .detail-row-icon.is-face {
      font-size: 1.1rem;
    }

    /* judul catatan memakai ukuran bulan di kalender versi ponsel */
    .detail-note-title {
      font-size: 1.05rem;
    }

    /* judul halaman dan baris di bawahnya turun satu ukuran, sama seperti
       di halaman writing */
    .header .header-title {
      font-size: 1.75rem;
    }

    .header .header-title + p {
      font-size: 0.8rem;
    }

    .detail-lock-note {
      font-size: 0.75rem;
    }

    .detail-cipher {
      font-size: 0.7rem;
    }

    /* isi catatan juga sedikit lebih kecil, termasuk heading-nya */
    .detail-note-head {
      margin-bottom: 0.35rem;
    }

    .detail-note-title {
      margin-bottom: 0.5rem;
    }

    .detail-card .note-body {
      font-size: 0.8rem;
    }

    .detail-card .note-body h2 {
      font-size: 1.08rem;
    }

    .detail-card .note-body h3 {
      font-size: 0.92rem;
    }
  }

  /* ukuran isi catatan sama dengan catatan di detail kontak, termasuk heading-nya */
  @media (min-width: 640px) {
    .detail-card .note-body {
      font-size: 0.9rem;
    }

    .detail-card .note-body h2 {
      font-size: 1.2rem;
    }

    .detail-card .note-body h3 {
      font-size: 1rem;
    }
  }
</style>

<!-- lebarnya sama dengan kalender writing -->
<div class="detail-page mx-auto grid w-full max-w-3xl grid-cols-1 gap-6 p-6 pt-14">
  <!-- tombol back mengambang, tepat di atas tombol menu -->
  <a
    href="/writing"
    aria-label="Back to writing"
    title="Back to writing"
    class="fab-back fab-simple doodle-btn fixed right-6 z-40 h-12 w-12 p-0 text-xl"
  >
    <%- include("partials/doodle-icon", { name: "arrow-left", cls: "fab-icon" }) %>
  </a>

  <!-- header halaman, sama seperti di halaman writing, dengan actions
       catatan di baris yang sama -->
  <div class="header flex items-end justify-between gap-4" data-stagger style="--i: 0">
    <div class="detail-header-text flex items-end gap-4">
      <div class="pb-1">
        <h2 class="header-title mb-1 text-4xl">
          <span class="header-title-mark">Writing</span>
        </h2>
        <p class="text-ink-soft font-comic font-bold">Read back your daily notes and stories</p>
      </div>
    </div>

    <!-- semua actions catatan ada di menu Actions:
           biasa      edit · download PDF · lock note · delete
           terkunci   edit · remove lock · delete, plus "decrypt" di luar
                      Actions (tanpa tombol itu catatan tidak bisa dibaca)
           terbuka    edit · download PDF · remove lock · delete
         (share, lock, dan remove lock hanya untuk pemilik. Decrypt hanya
         membuka catatan untuk dibaca, catatan tetap terkunci; edit dan remove
         lock juga meminta key. PDF dibuat di browser dari catatan yang tampil
         di halaman) -->
    <div class="detail-actions pb-1">
      <% if (lockedNote) { %>
      <button type="button" class="header-link is-primary" id="note-open" onclick="openKeyModal(event, 'unlock', '<%= writing._id %>')">
        <%- include("partials/doodle-icon", { name: "unlock" }) %>
        Decrypt
      </button>
      <% } %>

      <div class="actions-menu">
        <button type="button" class="header-link actions-menu-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="note-actions-menu">
          Actions
          <span class="actions-menu-chevron" aria-hidden="true"><%- include("partials/doodle-icon", { name: "chevron-right" }) %></span>
        </button>
        <div class="actions-menu-list" id="note-actions-menu" role="menu" aria-label="Note actions">
          <% if (access !== "view") { %>
          <a href="/writing/edit/<%= writing._id %>" role="menuitem">
            <%- include("partials/doodle-icon", { name: "pencil" }) %>
            Edit
          </a>
          <% } %>
          <!-- PDF catatan terkunci baru tersedia setelah catatan dibuka -->
          <button type="button" role="menuitem" id="note-pdf" data-file="<%= pdfName %>" <%= lockedNote ? "hidden" : "" %>>
            <%- include("partials/doodle-icon", { name: "download" }) %>
            <span id="note-pdf-label">Download PDF</span>
          </button>
          <% if (access === "owner") { %>
          <button type="button" role="menuitem" onclick="openModal(document.getElementById('share-modal'))">
            <%- include("partials/doodle-icon", { name: "share" }) %>
            Share
          </button>
          <% if (writing.isEncrypted) { %>
          <button type="button" role="menuitem" onclick="openKeyModal(event, 'decrypt', '<%= writing._id %>')">
            <%- include("partials/doodle-icon", { name: "unlock" }) %>
            Remove lock
          </button>
          <% } else { %>
          <button type="button" role="menuitem" onclick="openKeyModal(event, 'encrypt', '<%= writing._id %>')">
            <%- include("partials/doodle-icon", { name: "lock" }) %>
            Lock note
          </button>
          <% } %>
          <span class="actions-menu-sep" role="separator"></span>
          <button type="button" role="menuitem" class="is-danger" onclick="openDeleteModal()">
            <%- include("partials/doodle-icon", { name: "trash" }) %>
            Delete
          </button>
          <% } else { %>
          <!-- catatan yang dibagikan ke akun ini: hanya dihapus dari akun ini -->
          <span class="actions-menu-sep" role="separator"></span>
          <button type="button" role="menuitem" class="is-danger" onclick="openDeleteModal()">
            <%- include("partials/doodle-icon", { name: "trash" }) %>
            Remove from my notes
          </button>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- card -->
  <div class="detail-card grid grid-cols-1 gap-6 p-6 sm:p-8" data-stagger style="--i: 1">
    <% if (access !== "owner") { %>
    <p class="detail-shared justify-self-start">
      <%- include("partials/doodle-icon", { name: "share" }) %>
      Shared by <%= writing.owner.username %> · <%= access === "edit" ? "you can edit" : "view only" %>
    </p>
    <% } %>
    <div class="detail-rows">
      <div class="detail-row">
        <span class="detail-row-icon" style="--icon-bg: var(--color-blush)">
          <%- include("partials/doodle-icon", { name: "calendar" }) %>
        </span>
        <div class="min-w-0">
          <span class="detail-label">Date</span>
          <span class="detail-row-value"><%= formatDate(writing.date) %></span>
          <%
            // catatan yang disimpan sebelum ada field editedAt memakai waktu
            // update terakhirnya, jika update itu terjadi setelah catatan dibuat
            const edited =
              writing.editedAt ||
              (writing.updatedAt && writing.createdAt && writing.updatedAt - writing.createdAt > 1000
                ? writing.updatedAt
                : null);
          %>
          <% if (edited) { %>
          <span class="detail-edited">Edited <%= formatDate(edited) %></span>
          <% } %>
        </div>
      </div>

      <div class="detail-row">
        <span class="detail-row-icon <%= face ? 'is-face' : '' %>" style="--icon-bg: var(--color-mint)">
          <% if (face) { %><span aria-hidden="true"><%= face %></span><% } else { %><%- include("partials/doodle-icon", { name: "heart" }) %><% } %>
        </span>
        <div class="min-w-0">
          <span class="detail-label">Feeling</span>
          <span class="detail-row-value <%= writing.mood ? '' : 'detail-empty' %>"><%= writing.mood || "—" %></span>
        </div>
      </div>
    </div>

    <div class="detail-divider"></div>

    <div class="flex flex-col gap-3">
      <!-- label catatan. Pada catatan terkunci ada tanda kecil di sampingnya:
           "locked", lalu "decrypted" selama catatan terbuka di kunjungan ini -->
      <div class="detail-note-head">
        <span class="detail-label inline-flex items-center gap-1.5">
          <%- include("partials/doodle-icon", { name: "note" }) %>
          Note
        </span>
        <% if (lockedNote) { %>
        <span class="detail-lock-note" id="note-locked-mark">
          <%- include("partials/doodle-icon", { name: "lock" }) %>
          This note is locked
        </span>
        <span class="detail-lock-note" id="note-decrypted" hidden>
          <%- include("partials/doodle-icon", { name: "unlock" }) %>
          Decrypted
        </span>
        <% } %>
      </div>

      <!-- judul catatan di bawah labelnya, gayanya seperti bulan di
           kalender -->
      <h3 class="detail-note-title text-2xl"><span class="header-title-mark"><%= writing.title %></span></h3>

      <% if (lockedNote) { %>
      <div id="note-locked">
        <div class="detail-cipher"><%= writing.content.slice(0, 3000) %></div>
      </div>
      <!-- diisi setelah catatan dibuka -->
      <div class="note-body <%= writing.paper === 'lined' ? 'is-lined' : '' %>" id="note-body" hidden></div>
      <% } else { %>
      <div class="note-body <%= writing.paper === 'lined' ? 'is-lined' : '' %>"><%- noteHtml(writing.content) %></div>
      <% } %>
    </div>
  </div>

  <% if (access === "owner") { %>
  <%- include("partials/share-modal", { base: "/writing/" + writing._id, noun: "note", shares }) %>
  <% } %>

  <!-- konfirmasi delete (catatan yang dibagikan ke akun ini hanya dihapus
       dari akun ini, pemiliknya tetap menyimpannya) -->
  <div id="delete-modal" class="doodle-modal">
    <div class="delete-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-title">
      <% if (access === "owner") { %>
      <h2 id="delete-title" class="mb-1 text-2xl">Delete note?</h2>
      <p class="text-ink-soft font-comic font-bold">
        <%= writing.title %> will be removed from your notes.
      </p>
      <% } else { %>
      <h2 id="delete-title" class="mb-1 text-2xl">Remove note?</h2>
      <p class="text-ink-soft font-comic font-bold">
        <%= writing.title %> will be removed from your notes. <%= writing.owner.username %> still keeps it.
      </p>
      <% } %>

      <div class="mt-6 flex items-center justify-end gap-2">
        <button type="button" onclick="closeDeleteModal()" class="delete-link">Cancel</button>
        <% if (access === "owner") { %>
        <form id="delete-form" action="/writing?_method=DELETE" method="post">
          <input type="hidden" name="_id" value="<%= writing._id %>" />
          <input type="hidden" name="title" value="<%= writing.title %>" />
          <button type="submit" class="doodle-btn doodle-btn-sm doodle-btn-danger">
            Yes
          </button>
        </form>
        <% } else { %>
        <form id="delete-form" action="/writing/<%= writing._id %>/shares/<%= user._id %>?_method=DELETE" method="post">
          <button type="submit" class="doodle-btn doodle-btn-sm doodle-btn-danger">
            Yes
          </button>
        </form>
        <% } %>
      </div>
    </div>
  </div>

  <!-- lock dan remove lock mengirim catatan lewat form ini, dalam bentuk
       terkunci atau sudah dibuka dengan key-nya (key-nya tidak pernah dikirim) -->
  <form id="lock-form" method="post" hidden>
    <input type="hidden" name="_id" value="<%= writing._id %>" />
    <input type="hidden" name="redirect" id="lock-redirect" />
    <input type="hidden" name="content" id="lock-content" />
    <input type="hidden" name="salt" id="lock-salt" />
    <input type="hidden" name="iv" id="lock-iv" />
  </form>

  <%- include("partials/key-modal") %>
</div>

<% if (lockedNote) { %>
<script type="application/json" id="note-cipher"><%- jsValue(lockedPayload) %></script>
<% } %>

<script>
  // aksi popup key di halaman ini, semuanya berjalan di browser
  (() => {
    const lockForm = document.getElementById("lock-form");
    const cipherEl = document.getElementById("note-cipher");
    const note = cipherEl ? JSON.parse(cipherEl.textContent) : null;
    const body = document.querySelector(".detail-card .note-body");

    function send(action, fields) {
      lockForm.action = "/writing/" + action;
      document.getElementById("lock-redirect").value =
        window.location.pathname + window.location.search;
      ["content", "salt", "iv"].forEach((name) => {
        document.getElementById("lock-" + name).value = fields[name] || "";
      });
      lockForm.submit();
    }

    window.keyModalActions = {
      // hanya dibuka untuk dibaca di sini; catatan tetap terkunci di server
      async unlock(key) {
        body.innerHTML = await noteCrypto.open(note, key);
        body.hidden = false;
        document.getElementById("note-locked").hidden = true;
        document.getElementById("note-locked-mark").hidden = true;
        document.getElementById("note-decrypted").hidden = false;
        document.getElementById("note-open").hidden = true;
        document.getElementById("note-pdf").hidden = false;
        closeKeyModal();
      },
      // catatan disimpan tanpa kunci: isinya dikirim ke server, key-nya tidak
      async decrypt(key) {
        send("decrypt", { content: await noteCrypto.open(note, key) });
      },
      // di-encrypt di browser, lalu dikirim sebagai ciphertext
      async encrypt(key) {
        const problem = noteCrypto.keyProblem(key);
        if (problem) throw new Error(problem);
        send("encrypt", await noteCrypto.encrypt(body.innerHTML, key));
      },
    };

    // dibuka dari catatan terkunci di kalender writing: popup key langsung
    // muncul (setelah helper popup dari layout di bawah siap)
    if (note && window.location.hash === "#open") {
      history.replaceState(null, "", window.location.pathname + window.location.search);
      document.addEventListener("DOMContentLoaded", () => openKeyModal(null, "unlock", note.id));
    }
  })();
</script>

<%- include("partials/actions-menu-script") %>

<script src="/js/note-pdf.js"></script>
<script>
  // download catatan sebagai PDF, lengkap dengan judul, tanggal, dan mood
  (() => {
    const btn = document.getElementById("note-pdf");
    const label = document.getElementById("note-pdf-label");
    const labelHtml = label.innerHTML;
    btn.addEventListener("click", async () => {
      if (btn.disabled) return;
      btn.disabled = true;
      label.textContent = "Making PDF…";
      try {
        await notePdf({
          body: document.querySelector(".detail-card .note-body"),
          title: <%- jsValue(writing.title || "") %>,
          meta: [
            <%- jsValue(formatDate(writing.date)) %>,
            <%- jsValue(writing.mood || "") %>,
            <%- jsValue(edited ? "Edited " + formatDate(edited) : "") %>,
          ].filter(Boolean).join("  ·  "),
          fileName: btn.dataset.file,
          decrypted: <%- jsValue(Boolean(writing.isEncrypted)) %>,
        });
        label.innerHTML = labelHtml;
      } catch (e) {
        label.textContent = "Couldn't make it, try again";
      } finally {
        btn.disabled = false;
      }
    });
  })();
</script>

<script>
  const modal = document.getElementById("delete-modal");

  function openDeleteModal() {
    openModal(modal);
  }

  function closeDeleteModal() {
    closeModal(modal);
  }
</script>
