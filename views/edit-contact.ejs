<%
  // re-rendered after a failed validation: keep what was typed, show why
  const values = contact || {};
  const errorList = typeof errors !== "undefined" && errors ? errors : [];
  const fieldError = (field) => {
    const hit = errorList.find((e) => e.path === field || e.param === field);
    return hit ? hit.msg : "";
  };
%>
<%- include("partials/contact-form-styles") %>

<div class="form-page mx-auto grid w-full max-w-2xl grid-cols-1 gap-6 p-6 pt-14">
  <!-- floating back button, stacked above the menu button -->
  <a
    href="/contact/<%= values._id %>"
    aria-label="Back to contact"
    title="Back to contact"
    class="fab-back fab-simple doodle-btn fixed right-6 z-40 h-12 w-12 p-0 text-xl"
  >
    <%- include("partials/doodle-icon", { name: "arrow-left", cls: "fab-icon" }) %>
  </a>

  <!-- header, same pattern as the new contact page -->
  <div class="header flex items-end justify-between gap-4" data-stagger style="--i: 0">
    <div class="flex items-end gap-4">
      <div class="pb-1">
        <h2 class="header-title mb-1 text-4xl">
          <span class="header-title-mark">Edit Contact</span>
        </h2>
        <p class="text-ink-soft font-comic font-bold">Keep their details up to date</p>
      </div>
    </div>
  </div>

  <form
    method="post"
    action="/contact?_method=PUT"
    enctype="multipart/form-data"
    class="form-card grid grid-cols-1 gap-6 p-6 sm:p-8"
    data-stagger
    style="--i: 1"
    novalidate
  >
    <input type="hidden" name="_id" value="<%= values._id %>" />
    <input type="hidden" name="oldName" value="<%= values.oldName || values.name %>" />
    <input type="hidden" id="current-image" name="image" value="<%= values.image || '' %>" />

    <!-- avatar -->
    <div class="flex flex-col items-center gap-2">
      <label class="avatar-pick" title="Choose a photo">
        <input type="file" id="image" name="image" accept="image/*" class="sr-only" />
        <span class="avatar-pick-face" id="avatar-face">
          <span id="default-avatar" class="<%= values.image ? 'hidden' : '' %>"><%- include("partials/doodle-icon", { name: "person" }) %></span>
          <img id="preview-image" src="<%= values.image || '' %>" alt="" class="<%= values.image ? '' : 'hidden' %>" />
        </span>
        <span class="avatar-pick-badge" aria-hidden="true">
          <%- include("partials/doodle-icon", { name: "camera" }) %>
        </span>
        <span class="sr-only">Choose a photo</span>
      </label>
      <button id="remove-image" type="button" class="remove-photo <%= values.image ? '' : 'hidden' %>">Remove photo</button>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div class="field <%= fieldError('name') ? 'has-error' : '' %>">
        <label for="name" class="field-label"><span>Name</span><span class="req" aria-hidden="true"></span></label>
        <input type="text" id="name" name="name" value="<%= values.name || '' %>" placeholder="Their name" required class="doodle-input field-input" />
        <% if (fieldError("name")) { %><span class="field-error"><%= fieldError("name") %></span><% } %>
      </div>

      <div class="field field-phone <%= fieldError('phone') ? 'has-error' : '' %>">
        <label for="phone" class="field-label"><span>Phone</span><span class="req" aria-hidden="true"></span></label>
        <input type="tel" id="phone" name="phone" value="<%= values.phone || '' %>" placeholder="08xx xxxx xxxx" required inputmode="tel" class="doodle-input field-input" />
        <% if (fieldError("phone")) { %><span class="field-error"><%= fieldError("phone") %></span><% } %>
      </div>

      <div class="field <%= fieldError('email') ? 'has-error' : '' %>">
        <label for="email" class="field-label"><span>Email</span><span class="req" aria-hidden="true"></span></label>
        <input type="email" id="email" name="email" value="<%= values.email || '' %>" placeholder="name@example.com" required class="doodle-input field-input" />
        <% if (fieldError("email")) { %><span class="field-error"><%= fieldError("email") %></span><% } %>
      </div>

      <div class="field">
        <label for="company" class="field-label"><span>Company</span><span class="req" aria-hidden="true"></span></label>
        <input type="text" id="company" name="company" value="<%= values.company || '' %>" placeholder="Where they work" required class="doodle-input field-input" />
      </div>

      <div class="field sm:col-span-2">
        <label for="notes" class="field-label"><span>Notes</span><span class="req" aria-hidden="true"></span></label>
        <textarea id="notes" name="notes" placeholder="Anything worth remembering about them…" required class="doodle-input field-input"><%= values.notes || '' %></textarea>
      </div>
    </div>

    <div class="form-actions">
      <a href="/contact/<%= values._id %>" class="cancel-link">Cancel</a>
      <button id="submit-form" class="doodle-btn doodle-btn-ink px-6" type="button">
        <%- include("partials/doodle-icon", { name: "pencil" }) %>
        Save changes
      </button>
    </div>
  </form>
</div>

<script>
  const input = document.getElementById("image");
  const preview = document.getElementById("preview-image");
  const defaultAvatar = document.getElementById("default-avatar");
  const currentImage = document.getElementById("current-image");
  const removeBtn = document.getElementById("remove-image");
  const submitBtn = document.getElementById("submit-form");
  const form = submitBtn.closest("form");

  input.addEventListener("change", function () {
    const file = this.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function (e) {
      preview.src = e.target.result;
      preview.classList.remove("hidden");
      defaultAvatar.classList.add("hidden");
      removeBtn.classList.remove("hidden");
    };
    reader.readAsDataURL(file);
  });

  removeBtn.addEventListener("click", function () {
    input.value = "";
    currentImage.value = "";
    preview.src = "";
    preview.classList.add("hidden");
    removeBtn.classList.add("hidden");
    defaultAvatar.classList.remove("hidden");
  });

  submitBtn.addEventListener("click", () => {
    if (!form.reportValidity()) return;

    submitBtn.disabled = true;
    submitBtn.classList.add("opacity-70", "cursor-wait");
    submitBtn.textContent = "Saving…";

    setTimeout(() => {
      form.submit();
    }, 1000);
  });
</script>
