<div class="py-8">
  <div class="m-auto grid w-[50%] grid-cols-1 gap-6">
    <div>
      <button
        class="flex cursor-pointer items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-3 py-0.5 text-sm font-medium text-neutral-800 shadow-2xs transition duration-200 ease-in-out hover:bg-neutral-100"
        onclick="window.location.href = '/contact/<%= contact._id %>'"
      >
        <i class="bi bi-arrow-left-short text-2xl"></i>
        Back
      </button>
    </div>
    <div
      class="grid grid-cols-1 gap-12 rounded-xl border border-neutral-200 p-6 shadow"
    >
      <h1 class="text-3xl font-medium">Edit Contact</h1>
      <form
        method="post"
        action="/contact?_method=PUT"
        enctype="multipart/form-data"
      >
        <input type="hidden" name="_id" value="<%= contact._id %>" />
        <input
          type="hidden"
          name="oldName"
          value="<%= contact.oldName || contact.name %>"
        />
        <input type="hidden" name="image" value="<%= contact.image %>" />

        <div class="mb-3 flex flex-col gap-2">
          <label for="image" class="text-sm font-medium"> Avatar </label>
          <img
            id="preview-image"
            src="<%= contact.image || '' %>"
            alt="Preview"
            class="<%= contact.image ? '' : 'hidden' %> mb-2 h-30 w-30 rounded-md object-cover"
          />
          <i
            id="default-avatar"
            class="bi bi-person-fill <%= contact.image ? 'hidden' : '' %> mb-2 flex h-30 w-30 items-center justify-center rounded-md bg-neutral-300/50 text-6xl text-neutral-600/50"
          ></i>

          <div class="relative w-full">
            <input
              type="file"
              id="image"
              name="image"
              accept="image/*"
              class="w-full cursor-pointer rounded-md border border-neutral-300 py-2 pr-10 pl-3 text-sm focus:border-neutral-400 focus:ring-2 focus:ring-neutral-800/20 focus:outline-none"
            />
            <button
              id="remove-image"
              type="button"
              class="absolute top-1/2 right-2.5 -translate-y-1/2 cursor-pointer rounded-md bg-red-600 px-2 py-1 text-xs text-white transition duration-200 ease-in-out hover:bg-red-500"
            >
              <i class="bi bi-trash3"></i>
            </button>
          </div>
        </div>

        <div class="mb-3 flex flex-col gap-2">
          <label for="name" class="text-sm font-medium">
            Name
            <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            placeholder="Enter your name"
            value="<%= contact.name %>"
            required
            class="rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-400 focus:ring-2 focus:ring-neutral-800/20 focus:outline-none"
          />
        </div>
        <div class="mb-3 flex flex-col gap-2">
          <label for="email" class="text-sm font-medium">
            Email
            <span class="text-red-500">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="Enter your email"
            value="<%= contact.email %>"
            required
            class="rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-400 focus:ring-2 focus:ring-neutral-800/20 focus:outline-none"
          />
        </div>
        <div class="mb-3 flex flex-col gap-2">
          <label for="phone" class="text-sm font-medium">
            Phone
            <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="phone"
            name="phone"
            placeholder="Enter your phone"
            value="<%= contact.phone %>"
            required
            class="rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-400 focus:ring-2 focus:ring-neutral-800/20 focus:outline-none"
          />
        </div>
        <div class="mb-3 flex flex-col gap-2">
          <label for="company" class="text-sm font-medium"> Company </label>
          <input
            type="text"
            id="company"
            name="company"
            placeholder="Enter your company"
            value="<%= contact.company %>"
            required
            class="rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-400 focus:ring-2 focus:ring-neutral-800/20 focus:outline-none"
          />
        </div>

        <div class="mb-3 flex flex-col gap-2">
          <label for="notes" class="text-sm font-medium"> Notes </label>
          <textarea
            type="text"
            id="notes"
            name="notes"
            placeholder="Add any additional notes about this contact..."
            required
            class="rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-400 focus:ring-2 focus:ring-neutral-800/20 focus:outline-none"
          >
<%= contact.notes %></textarea
          >
        </div>

        <div class="mt-12 grid grid-cols-2 gap-4">
          <button
            class="cursor-pointer rounded-md bg-neutral-950 px-3 py-1.5 text-sm text-white transition duration-200 ease-in-out hover:bg-neutral-800"
            type="button"
            id="submit-form"
          >
            Save Changes
          </button>
          <button
            class="cursor-pointer rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-sm font-medium text-neutral-800 shadow-2xs transition duration-200 ease-in-out hover:bg-neutral-100"
            type="button"
            onclick="window.location.href = '/contact/<%= contact._id %>'"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const input = document.getElementById("image");
  const preview = document.getElementById("preview-image");
  const defaultAvatar = document.getElementById("default-avatar");
  const removeBtn = document.getElementById("remove-image");
  const submitBtn = document.getElementById("submit-form");
  const form = submitBtn.closest("form");

  input.addEventListener("change", function () {
    const file = this.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function (e) {
      preview.src = e.target.result;
      preview.classList.remove("hidden");

      if (defaultAvatar) defaultAvatar.classList.add("hidden");
      removeBtn.classList.remove("hidden");
    };

    reader.readAsDataURL(file);
  });

  removeBtn.addEventListener("click", function () {
    input.value = "";

    preview.src = "";
    preview.classList.add("hidden");
    removeBtn.classList.add("hidden");

    if (defaultAvatar) defaultAvatar.classList.remove("hidden");
  });

  submitBtn.addEventListener("click", () => {
    submitBtn.disabled = true;
    submitBtn.classList.add("opacity-70", "cursor-wait");
    submitBtn.innerHTML = `
      <i class="bi bi-arrow-repeat animate-spin"></i>
      <span>Loading...</span>
    `;

    setTimeout(() => {
      form.submit();
    }, 1000);
  });
</script>
