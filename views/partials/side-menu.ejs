<!-- Floating side menu: a draggable tab that snaps to the window edges -->
<div id="side-menu" class="fixed top-3 right-0 z-50 flex">
  <button
    type="button"
    id="side-menu-tab"
    title="Click to open the menu, drag to move, double-click to reset"
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls="side-menu-panel"
    aria-label="open menu"
  >
    <svg
      id="side-menu-icon-lines"
      width="17"
      height="13"
      viewBox="0 0 15 12"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M1.3,2 Q6.5,0.7 13.7,1.8" />
      <path d="M1.6,5.9 Q8,4.8 13.3,6.1" />
      <path d="M1.3,9.8 Q6,8.6 13.6,9.9" />
    </svg>
    <svg
      id="side-menu-icon-x"
      class="hidden"
      width="17"
      height="13"
      viewBox="0 0 13 13"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M1.9,1.7 Q7,6.4 11.3,11.4" />
      <path d="M11.3,1.9 Q6.6,6.9 1.7,11.2" />
    </svg>
  </button>

  <div id="side-menu-hint" aria-hidden="true">
    <span id="side-menu-hint-text">click menu</span>
    <span id="side-menu-hint-arrow">
      <svg width="32" height="16" viewBox="0 0 30 16" fill="none">
        <path
          id="side-menu-hint-dots"
          d="M2,12 Q13,2 25,6"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-dasharray="0.1 4.5"
        />
        <path
          d="M19,2 L25,6 L18,9"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </span>
  </div>

  <div id="side-menu-panel" role="menu" aria-labelledby="side-menu-tab">
    <div class="sm-brand" data-menu-item>
      <i class="bi bi-pencil-fill"></i>
      My App
    </div>
    <a
      href="/contacts"
      data-menu-item
      class="sm-item <%= path.startsWith('/contact') ? 'is-active' : '' %>"
      style="--ink: var(--color-crayon)"
      <%- path.startsWith('/contact') ? 'aria-current="page"' : '' %>
    >
      <i class="bi bi-people"></i>
      <span><span class="sm-slash">./</span>contacts</span>
    </a>
    <a
      href="/writing"
      data-menu-item
      class="sm-item <%= path.startsWith('/writing') ? 'is-active' : '' %>"
      style="--ink: var(--color-mint)"
      <%- path.startsWith('/writing') ? 'aria-current="page"' : '' %>
    >
      <i class="bi bi-journal-text"></i>
      <span><span class="sm-slash">./</span>writing</span>
    </a>
    <button type="button" id="side-menu-reset" data-menu-item class="sm-reset">
      <i class="bi bi-arrow-counterclockwise"></i>
      restore position
    </button>
  </div>
</div>

<style>
  #side-menu-tab {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.2rem;
    padding: 0 0.85rem;
    color: var(--color-ink-soft);
    background-color: var(--color-card);
    border: 1.5px solid var(--color-ink);
    box-shadow: 0 8px 20px -12px rgba(0, 0, 0, 0.45);
    cursor: grab;
    /* keeps a touch drag from scrolling the page underneath */
    touch-action: none;
    user-select: none;
    transition:
      background-color 0.18s ease,
      color 0.18s ease;
  }

  #side-menu-tab:hover,
  #side-menu.is-open #side-menu-tab {
    color: var(--color-on-accent);
    background-color: var(--color-marker);
  }

  #side-menu.is-dragging #side-menu-tab {
    cursor: grabbing;
  }

  #side-menu-hint {
    position: absolute;
    top: 50%;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
    pointer-events: none;
    color: var(--color-crayon);
    opacity: 0.85;
    transform: translateY(-50%);
    transition: opacity 0.2s ease;
  }

  #side-menu-hint-text {
    font-family: var(--font-hand);
    font-size: 1.3rem;
    font-weight: 700;
    transform: rotate(-4deg);
  }

  #side-menu-hint-arrow {
    display: flex;
    animation: sm-nudge 1.1s ease-in-out infinite alternate;
  }

  #side-menu-hint-dots {
    animation: sm-dash 0.85s linear infinite;
  }

  /* hint sits on the opposite side of whichever edge the tab is parked at */
  #side-menu[data-side="left"] #side-menu-hint {
    left: calc(100% + 4px);
    flex-direction: row-reverse;
  }

  #side-menu[data-side="left"] #side-menu-hint-arrow {
    transform: scaleX(-1);
  }

  #side-menu:not([data-side="left"]) #side-menu-hint {
    right: calc(100% + 4px);
  }

  #side-menu.is-dragging #side-menu-hint {
    opacity: 0;
  }

  @media (max-width: 640px) {
    #side-menu-hint {
      display: none;
    }
  }

  @keyframes sm-nudge {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(4px);
    }
  }

  #side-menu[data-side="left"] #side-menu-hint-arrow {
    animation-name: sm-nudge-left;
  }

  @keyframes sm-nudge-left {
    from {
      transform: scaleX(-1) translateX(0);
    }
    to {
      transform: scaleX(-1) translateX(4px);
    }
  }

  @keyframes sm-dash {
    to {
      stroke-dashoffset: -4.6;
    }
  }

  #side-menu-panel {
    position: absolute;
    top: calc(100% + 8px);
    display: flex;
    min-width: 12rem;
    flex-direction: column;
    padding: 0.5rem;
    background-color: var(--color-card);
    border: 1.5px solid var(--color-line);
    box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.35);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px);
    transition:
      opacity 0.18s ease,
      transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1),
      visibility 0.18s;
  }

  #side-menu[data-open-up="true"] #side-menu-panel {
    top: auto;
    bottom: calc(100% + 8px);
    transform: translateY(8px);
  }

  #side-menu[data-side="left"] #side-menu-panel {
    left: 0;
  }

  #side-menu:not([data-side="left"]) #side-menu-panel {
    right: 0;
  }

  #side-menu.is-open #side-menu-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* items drift in from the parked edge, one after another */
  #side-menu-panel [data-menu-item] {
    opacity: 0;
    transform: translateX(14px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  #side-menu[data-side="left"] #side-menu-panel [data-menu-item] {
    transform: translateX(-14px);
  }

  #side-menu.is-open #side-menu-panel [data-menu-item] {
    opacity: 1;
    transform: translateX(0);
  }

  #side-menu.is-open #side-menu-panel [data-menu-item]:nth-child(1) {
    transition-delay: 0.04s;
  }
  #side-menu.is-open #side-menu-panel [data-menu-item]:nth-child(2) {
    transition-delay: 0.085s;
  }
  #side-menu.is-open #side-menu-panel [data-menu-item]:nth-child(3) {
    transition-delay: 0.13s;
  }
  #side-menu.is-open #side-menu-panel [data-menu-item]:nth-child(4) {
    transition-delay: 0.175s;
  }

  .sm-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.6rem 0.65rem;
    margin-bottom: 0.35rem;
    font-size: 1.05rem;
    font-weight: 800;
    border-bottom: 1.5px solid var(--color-line);
  }

  .sm-brand i {
    color: var(--color-crayon);
  }

  .sm-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    white-space: nowrap;
    text-decoration: none;
    border-radius: 0.75rem;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .sm-item i {
    color: var(--color-ink-soft);
    transition: color 0.15s ease;
  }

  .sm-item:hover,
  .sm-item.is-active {
    color: var(--color-ink);
    background-color: color-mix(in srgb, var(--ink) 18%, var(--color-card));
  }

  .sm-item:hover i,
  .sm-item.is-active i {
    color: var(--color-ink);
  }

  .sm-item.is-active {
    font-weight: 800;
  }

  .sm-slash {
    color: var(--color-ink-soft);
    font-weight: 600;
  }

  .sm-reset {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem 0.25rem;
    margin-top: 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
    background: none;
    border: none;
    border-top: 1.5px solid var(--color-line);
    transition: color 0.15s ease;
  }

  .sm-reset:hover {
    color: var(--color-ink);
  }

  #side-menu.is-moved .sm-reset {
    display: flex;
  }

  @media (prefers-reduced-motion: reduce) {
    #side-menu-hint-arrow,
    #side-menu-hint-dots {
      animation: none;
    }

    #side-menu-panel,
    #side-menu-panel [data-menu-item] {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  (() => {
    const DRAG_KEY = "side-menu-pos";
    const MIN_TOP = 8;
    const MIN_BOTTOM = 16;
    const GAP = 8;
    const SNAP = 44;
    const DRAG_THRESHOLD = 4;

    const root = document.getElementById("side-menu");
    const tab = document.getElementById("side-menu-tab");
    const panel = document.getElementById("side-menu-panel");
    const hintText = document.getElementById("side-menu-hint-text");
    const iconLines = document.getElementById("side-menu-icon-lines");
    const iconX = document.getElementById("side-menu-icon-x");
    const resetBtn = document.getElementById("side-menu-reset");

    let place = null; // null = parked at the default spot, top right
    let open = false;
    let drag = null;
    let suppressClick = false;

    // Rounds off only the corners that are not touching the window edge
    function applyEdge(side) {
      const radius = (r) =>
        side === "right"
          ? `${r} 0 0 ${r}`
          : side === "left"
            ? `0 ${r} ${r} 0`
            : r;

      tab.style.borderRadius = radius("999px");
      panel.style.borderRadius = radius("18px");

      [tab, panel].forEach((el) => {
        el.style.borderLeftWidth = side === "left" ? "0" : "1.5px";
        el.style.borderRightWidth = side === "right" ? "0" : "1.5px";
      });
    }

    function resolve(rawX, rawY) {
      const tabW = tab.offsetWidth;
      const tabH = tab.offsetHeight;
      const panelH = panel.offsetHeight;

      const maxX = Math.max(0, window.innerWidth - tabW);
      const maxY = Math.max(MIN_TOP, window.innerHeight - tabH - MIN_BOTTOM);

      let x = Math.min(Math.max(rawX, 0), maxX);
      const y = Math.min(Math.max(rawY, MIN_TOP), maxY);

      let side = "free";
      if (x <= SNAP) {
        x = 0;
        side = "left";
      } else if (x >= maxX - SNAP) {
        x = maxX;
        side = "right";
      }

      const roomBelow = window.innerHeight - MIN_BOTTOM - (y + tabH + GAP);
      return { x, y, side, openUp: panelH > 0 && roomBelow < panelH };
    }

    function render() {
      const side = place ? place.side : "right";

      if (place) {
        root.style.left = place.x + "px";
        root.style.top = place.y + "px";
        root.style.right = "auto";
        root.style.bottom = "auto";
      } else {
        root.style.left = "";
        root.style.top = "";
        root.style.right = "";
        root.style.bottom = "";
      }

      root.classList.toggle("is-moved", place !== null);
      root.dataset.side = side;
      root.dataset.openUp = place && place.openUp ? "true" : "false";
      applyEdge(side);
    }

    function setOpen(next) {
      open = next;
      root.classList.toggle("is-open", open);
      tab.setAttribute("aria-expanded", String(open));
      tab.setAttribute("aria-label", open ? "close menu" : "open menu");
      hintText.textContent = open ? "close menu" : "click menu";
      iconLines.classList.toggle("hidden", open);
      iconX.classList.toggle("hidden", !open);

      // the panel only knows its height once it has been laid out
      if (open && place) {
        place = resolve(place.x, place.y);
        render();
      }
    }

    function savePlace() {
      const rect = tab.getBoundingClientRect();
      try {
        localStorage.setItem(
          DRAG_KEY,
          JSON.stringify({ x: rect.left, y: rect.top })
        );
      } catch {}
    }

    function resetPlace() {
      place = null;
      try {
        localStorage.removeItem(DRAG_KEY);
      } catch {}
      render();
    }

    try {
      const stored = localStorage.getItem(DRAG_KEY);
      if (stored) {
        const { x, y } = JSON.parse(stored);
        if (Number.isFinite(x) && Number.isFinite(y)) place = resolve(x, y);
      }
    } catch {}

    render();

    tab.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "mouse" && e.button !== 0) return;
      const rect = tab.getBoundingClientRect();
      drag = { dx: e.clientX - rect.left, dy: e.clientY - rect.top, moved: false };
      tab.setPointerCapture(e.pointerId);
    });

    tab.addEventListener("pointermove", (e) => {
      if (!drag) return;
      const next = resolve(e.clientX - drag.dx, e.clientY - drag.dy);

      if (!drag.moved) {
        const rect = tab.getBoundingClientRect();
        if (
          Math.abs(next.x - rect.left) < DRAG_THRESHOLD &&
          Math.abs(next.y - rect.top) < DRAG_THRESHOLD
        ) {
          return;
        }
        drag.moved = true;
        root.classList.add("is-dragging");
      }

      place = next;
      render();
    });

    function endDrag(e) {
      const d = drag;
      drag = null;
      root.classList.remove("is-dragging");
      if (tab.hasPointerCapture(e.pointerId)) tab.releasePointerCapture(e.pointerId);
      if (!d || !d.moved) return;
      suppressClick = true;
      savePlace();
    }

    tab.addEventListener("pointerup", endDrag);
    tab.addEventListener("pointercancel", endDrag);

    tab.addEventListener("click", () => {
      if (suppressClick) {
        suppressClick = false;
        return;
      }
      setOpen(!open);
    });

    tab.addEventListener("dblclick", resetPlace);
    resetBtn.addEventListener("click", resetPlace);

    window.addEventListener("resize", () => {
      if (!place) return;
      place = resolve(place.x, place.y);
      render();
    });

    document.addEventListener("mousedown", (e) => {
      if (open && !root.contains(e.target)) setOpen(false);
    });

    document.addEventListener("touchstart", (e) => {
      if (open && !root.contains(e.target)) setOpen(false);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && open) {
        setOpen(false);
        tab.focus();
      }
    });
  })();
</script>
