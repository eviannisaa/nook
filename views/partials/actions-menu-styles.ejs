<!-- Menu Actions di halaman detail (catatan, kontak): tombol kalem bergaya
     teks header, dengan chevron kecil yang menghadap ke atas saat terbuka,
     dan menunya berupa kartu kertas kecil di bawahnya. Tombol di sebelahnya
     ("Decrypt" pada catatan) memakai tampilan yang sama: .header-link, dan
     .is-primary untuk warna sage -->
<style>
  /* Actions: tombol kalem dengan chevron kecil yang menghadap ke atas saat
     terbuka, dan menunya berupa kartu kertas kecil di bawahnya */
  .actions-menu {
    position: relative;
  }

  .header-link {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15rem 0.3rem;
    font-family: var(--font-comic);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: color 0.5s var(--ease-smooth);
  }

  /* Garis marker seperti di bawah judul catatan: sedikit miring, menutupi
     separuh bawah teks, dan muncul perlahan dari kiri */
  .header-link::before {
    content: "";
    position: absolute;
    left: 0.15rem;
    right: 0.2rem;
    bottom: calc(0.15rem + 0.12em);
    z-index: -1;
    height: 0.5em;
    background: linear-gradient(
      100deg,
      transparent 1%,
      color-mix(in srgb, var(--color-marker) 38%, transparent) 5%,
      color-mix(in srgb, var(--color-marker) 28%, transparent) 94%,
      transparent 99%
    );
    border-radius: 3px 10px 4px 12px;
    transform: rotate(-1.2deg) scaleX(0);
    transform-origin: left center;
    transition: transform 0.8s var(--ease-smooth);
  }

  .header-link .doodle-i {
    font-size: 0.95em;
  }

  .header-link:hover,
  .header-link:focus-visible,
  .header-link[aria-expanded="true"] {
    color: var(--color-ink);
    outline: none;
  }

  .header-link:hover::before,
  .header-link:focus-visible::before,
  .header-link[aria-expanded="true"]::before {
    transform: rotate(-1.2deg) scaleX(1);
  }

  .header-link.is-primary {
    color: var(--color-crayon);
  }

  .header-link.is-primary:hover,
  .header-link.is-primary:focus-visible {
    color: var(--color-primary-hover);
  }

  .actions-menu-btn {
    gap: 0.3rem;
  }

  .actions-menu-chevron {
    display: inline-flex;
    font-size: 0.7em;
    rotate: 90deg;
    transition: rotate 0.5s var(--ease-smooth);
  }

  .actions-menu-btn[aria-expanded="true"] .actions-menu-chevron {
    rotate: -90deg;
  }

  /* Menu berupa kartu kertas kecil di bawah Actions, terbuka ke kiri dari
     tepi kanannya */
  .actions-menu-list {
    position: absolute;
    top: calc(100% + 0.35rem);
    right: 0;
    z-index: 30;
    display: flex;
    min-width: 10rem;
    flex-direction: column;
    padding: 0.3rem;
    background-color: var(--color-card);
    border: 1.5px solid color-mix(in srgb, var(--color-ink) 18%, var(--color-line));
    border-radius: 16px 12px 17px 11px / 11px 17px 12px 16px;
    box-shadow: 0 10px 28px -14px rgba(0, 0, 0, 0.3);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-4px) scale(0.98);
    transform-origin: top right;
    transition:
      opacity 0.2s var(--ease-smooth),
      transform 0.2s var(--ease-smooth),
      visibility 0.2s;
  }

  .actions-menu.is-open .actions-menu-list {
    visibility: visible;
    opacity: 1;
    transform: none;
  }

  .actions-menu-list [role="menuitem"] {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.55rem;
    padding: 0.42rem 0.65rem;
    font-family: var(--font-comic);
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--color-ink-soft);
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
    border-radius: 11px 8px 12px 7px / 7px 12px 8px 11px;
    transition:
      color 0.25s var(--ease-smooth),
      background-color 0.25s var(--ease-smooth);
  }

  .actions-menu-list [role="menuitem"]:hover,
  .actions-menu-list [role="menuitem"]:focus-visible {
    color: var(--color-ink);
    background-color: color-mix(in srgb, var(--color-marker) 18%, transparent);
    outline: none;
  }

  /* Delete ada di paling bawah dan berubah merah berry saat di-hover */
  .actions-menu-list button.is-danger:hover,
  .actions-menu-list button.is-danger:focus-visible {
    color: var(--color-berry);
    background-color: color-mix(in srgb, var(--color-berry) 10%, transparent);
  }

  .actions-menu-sep {
    height: 0;
    margin: 0.3rem 0.5rem;
    border-top: 1.5px dashed color-mix(in srgb, var(--color-ink) 10%, var(--color-line));
  }

  @media (prefers-reduced-motion: reduce) {
    .actions-menu-list,
    .actions-menu-chevron,
    .header-link,
    .header-link::before {
      transition: none;
    }
  }

  @media (max-width: 639px) {
    .header-link {
      font-size: 0.8rem;
    }

    .actions-menu-list {
      min-width: 9rem;
    }

    .actions-menu-list [role="menuitem"] {
      padding: 0.38rem 0.6rem;
      font-size: 0.78rem;
    }
  }

  /* Item yang sedang disembunyikan halaman (PDF catatan terkunci) */
  .actions-menu-list [role="menuitem"][hidden] {
    display: none;
  }
</style>
