<%# tombol search + add yang mengambang, kapsul search, dan baris jumlah,
    dipakai bersama oleh halaman contacts dan writing %>
<style>
  /* jumlah total: keterangan samar supaya perhatian tertuju ke kontak, bukan ke sini */
  .contact-count {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-family: var(--font-comic);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-ink-soft);
  }

  /* angkanya sedikit lebih gelap dari labelnya, tapi tetap jauh lebih samar dari card */
  .contact-count-num {
    color: color-mix(in srgb, var(--color-ink) 70%, var(--color-ink-soft));
  }

  /* outline search box sama seperti card kontak: tinta lembut, jadi tinta penuh saat aktif */
  .search-input,
  .search-input:hover,
  .search-input:focus {
    font-family: var(--font-comic);
    /* ukurannya sama dengan keterangan jumlah kontak */
    font-size: 0.9rem;
    background-color: var(--color-card);
    border: 1.5px solid color-mix(in srgb, var(--color-ink) 50%, var(--color-line));
    border-radius: 22px 18px 24px 16px / 16px 24px 18px 22px;
    box-shadow: none;
    transition:
      border-color 0.5s var(--ease-soft),
      box-shadow 0.5s var(--ease-soft);
  }

  .search-input:hover {
    border-color: var(--color-ink);
  }

  .search-input:focus {
    border-color: var(--color-ink);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-secondary) 45%, transparent);
  }

  /* baris jumlah dan switch layout */
  .toolbar-row {
    position: relative;
    display: flex;
    min-height: 2.5rem;
    align-items: center;
    justify-content: space-between;
  }

  /* ponsel: jika tidak ada jumlah, baris ini hanya berisi search box (yang
     mengambang), jadi tidak memakan ruang di halaman */
  @media (max-width: 639px) {
    .toolbar-row:not(:has(.contact-count)) {
      display: contents;
    }

    /* jumlah diperkecil satu tingkat, seperti baris di bawah judul halaman */
    .contact-count {
      font-size: 0.8rem;
    }
  }

  /* search box mengambang: kapsul yang memanjang ke kiri dari tombol search.
     Tombol menutupi ujung kanannya, jadi keduanya terlihat menyatu. Saat
     dibuka, kapsul muncul dari tombol ke arah luar. */
  .search-box {
    position: fixed;
    right: 1.5rem; /* tepinya sama dengan tombol */
    top: calc(50% - 3.375rem); /* sejajar dengan tombol search */
    z-index: 39; /* tepat di bawah tombol, yang menutupi ujung kapsul */
    width: calc(100vw - 3rem);
    height: 3rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    /* clip diberi ruang lebih supaya focus ring dan shadow tidak terpotong */
    clip-path: inset(-24px -8px -24px calc(100% - 3rem) round 30px);
    transition:
      clip-path 0.45s var(--ease-smooth),
      opacity 0.3s var(--ease-smooth),
      visibility 0s linear 0.45s;
  }

  .search-box.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    clip-path: inset(-24px -8px -24px -8px round 30px);
    transition:
      clip-path 0.45s var(--ease-smooth),
      opacity 0.2s var(--ease-smooth),
      visibility 0s;
  }

  /* desktop: kapsul pendek, bukan bar panjang */
  @media (min-width: 640px) {
    .search-box {
      width: 16rem;
    }
  }

  /* input memenuhi kapsul; padding kanan memberi ruang di bawah tombol */
  /* sisi kiri tetap memakai outline tidak rata dan state focus seperti search
     box biasa; ujung kanannya dibentuk supaya menyambung dengan tombol */
  .search-box .search-input,
  .search-box .search-input:hover,
  .search-box .search-input:focus {
    width: calc(100% - 1.5rem); /* berakhir di bawah bagian tengah tombol */
    height: 100%;
    padding: 0 2.3rem 0 1.15rem;
    /* ujung kiri tetap memakai sudut doodle yang tidak rata; ujung kanan tanpa
       border dan tanpa lengkungan, terselip di bawah tombol supaya menyatu */
    border-right-width: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    box-shadow: 0 10px 24px -14px rgba(0, 0, 0, 0.35);
  }

  .search-box .search-input:focus {
    border-color: var(--color-ink);
    box-shadow: 0 10px 24px -14px rgba(0, 0, 0, 0.35);
  }

  /* focus ring membungkus seluruh kapsul (input + tombol) supaya tetap menyatu:
     sudut doodle di kiri, melengkung mengikuti tombol di kanan */
  .search-box::before {
    content: "";
    position: absolute;
    inset: -3px;
    z-index: -1;
    background-color: color-mix(in srgb, var(--color-secondary) 45%, transparent);
    /* radius kanan = setengah tinggi ring (54px). Jika memakai 999px, browser
       akan mengecilkan semua sudut sehingga sudut kiri jadi rata */
    border-radius: 25px 27px 27px 19px / 19px 27px 27px 25px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s var(--ease-smooth);
  }

  .search-box:focus-within::before {
    opacity: 1;
  }

  .search-box:has(.search-clear) .search-input {
    padding-right: 4.3rem;
  }

  .search-clear {
    position: absolute;
    top: 50%;
    right: 3.9rem;
    transform: translateY(-50%);
  }

  /* dua ikon tombol bergantian di posisi yang sama: search ↔ chevron (sembunyikan) */
  .fab-search .fab-icon {
    transition:
      opacity 0.45s var(--ease-smooth),
      transform 0.55s var(--ease-smooth);
  }

  .fab-search .fab-icon-close {
    position: absolute;
    opacity: 0;
    transform: translateX(-6px) scale(0.6);
  }

  .fab-search[aria-expanded="true"] .fab-icon-open {
    opacity: 0;
    transform: scale(0.6);
  }

  .fab-search[aria-expanded="true"] .fab-icon-close {
    opacity: 1;
    transform: none;
  }

  /* badge search aktif: lingkaran kertas kecil di sudut kanan atas tombol berisi
     huruf pertama query; muncul saat box disembunyikan */
  .search-badge {
    position: absolute;
    top: -0.3rem;
    right: -0.3rem;
    display: inline-flex;
    min-width: 1.35rem;
    height: 1.35rem;
    align-items: center;
    justify-content: center;
    padding: 0 0.3rem;
    font-family: var(--font-comic);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-ink);
    background-color: var(--color-card);
    border: 1.5px solid var(--color-ink);
    border-radius: 55% 45% 52% 48% / 48% 55% 45% 52%;
    box-shadow: 2px 2px 0 -1px color-mix(in srgb, var(--color-marker) 70%, transparent);
    opacity: 0;
    transform: scale(0.4);
    pointer-events: none;
    transition:
      opacity 0.3s var(--ease-smooth),
      transform 0.35s var(--ease-smooth);
  }

  .fab-search.has-query .search-badge {
    opacity: 1;
    transform: scale(1);
  }

  /* ikon + terlihat lebih tebal dari ikon search di ukuran yang sama, jadi sedikit diperkecil */
  .fab .fab-icon {
    width: 1.05em;
    height: 1.05em;
  }

  /* saat search terbuka, tombol di ujung kapsul mendapat garis tinta */
  .fab-search[aria-expanded="true"] {
    color: var(--color-ink);
    background-color: var(--color-card);
    border-color: var(--color-ink);
  }

  /* tombol search + add: sepasang tombol di tengah tepi kanan, search di atas,
     masing-masing 3rem dengan jarak 0.75rem (sudut bawah untuk tombol menu) */
  .fab-search {
    top: calc(50% - 3.375rem);
  }

  .fab {
    top: calc(50% + 0.375rem);
  }

  /* ponsel: selama search box terbuka, lapisan kertas naik dari bawah layar
     sampai tepat di atas input dan memudar di tepi atasnya, supaya tombol
     mengambang tidak menumpuk di atas konten yang ramai */
  .search-scrim {
    display: none;
  }

  @media (max-width: 959px) {
    .search-scrim {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 38; /* di bawah search box (39) dan tombol (40) */
      display: block;
      /* tablet: tombol search ada di 50% - 3.375rem, tingginya 3rem */
      height: calc(50% + 3.375rem + 2.5rem);
      background: linear-gradient(
        to top,
        var(--color-paper) calc(100% - 2.5rem),
        color-mix(in srgb, var(--color-paper) 0%, transparent)
      );
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition:
        opacity 0.4s var(--ease-smooth),
        visibility 0s linear 0.4s;
    }

    body:has(.search-box.is-open) .search-scrim {
      opacity: 1;
      visibility: visible;
      transition:
        opacity 0.4s var(--ease-smooth),
        visibility 0s;
    }
  }

  @media (max-width: 639px) {
    .search-scrim {
      /* ponsel: tombol search ada di bottom 7.2rem, tingginya 2.5rem */
      height: calc(7.2rem + 2.5rem + 2.5rem);
    }
  }

  /* tablet: gutter kiri dan kanan dibuat sama (5.25rem) supaya konten tidak
     tertutup tombol mengambang */
  @media (min-width: 640px) and (max-width: 959px) {
    .list-page {
      padding-right: 5.25rem;
      padding-left: 5.25rem;
    }
  }

  /* ponsel: tombol mengambang dibuat lebih kecil, menempel ke tepi, dan
     ditumpuk di sudut bawah. Gutter kiri dan kanan dibuat sama dan cukup
     lebar, supaya tidak ada konten yang tertutup tombol */
  @media (max-width: 639px) {
    /* gutter kiri dan kanan sama, cukup lebar di kanan supaya tidak tertutup
       tombol (tab 1.75rem di tepi + sedikit jarak) */
    .list-page {
      padding-right: 2.5rem;
      padding-left: 2.5rem;
    }

    /* ruang di bagian bawah supaya akhir halaman (pagination) bisa di-scroll
       melewati search box dan fade-nya: 5.35rem + 1.75rem + 2.5rem, ditambah
       sedikit jarak */
    .list-page {
      padding-bottom: 10.5rem;
    }

    .fab-search,
    .fab {
      right: 0.75rem;
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.05rem;
    }

    /* ditumpuk di sudut bawah, di atas tombol menu (bottom 1rem):
       menu → + → search, masing-masing 2.5rem dengan jarak 0.6rem */
    .fab {
      top: auto;
      bottom: 4.1rem;
    }

    .fab-search {
      top: auto;
      bottom: 7.2rem;
    }

    .search-box {
      top: auto;
      bottom: 7.2rem;
      right: 0.75rem;
      /* tepi kiri berjarak 3.5rem dari tepi layar */
      width: calc(100vw - 3.5rem - 0.75rem);
      height: 2.5rem;
    }

    .search-box .search-input,
    .search-box .search-input:hover,
    .search-box .search-input:focus {
      width: calc(100% - 1.25rem);
      padding-right: 1.9rem;
    }

    .search-box:has(.search-clear) .search-input {
      padding-right: 3.6rem;
    }

    .search-clear {
      right: 3.1rem;
    }

    .search-box::before {
      border-radius: 25px 23px 23px 19px / 19px 23px 23px 25px;
    }

    .search-box {
      clip-path: inset(-24px -8px -24px calc(100% - 2.5rem) round 30px);
    }

    .search-box.is-open {
      clip-path: inset(-24px -8px -24px -8px round 30px);
    }
  }

  /* tombol search + add versi ringkas: 2.5rem (di ponsel 1.75rem, lihat blok
     di bawah), ditumpuk di atas tombol menu. Kapsul search, focus ring-nya,
     dan scrim ikut menyesuaikan ukuran baru ini. */
  .fab-search,
  .fab {
    right: 1.75rem;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.05rem;
  }

  /* ditumpuk di sudut bawah, di atas tombol menu (bottom 1.5rem, tinggi
     2.5rem): search dan + berdekatan sebagai pasangan (0.4rem), dengan jarak
     sedikit lebih lebar (1.1rem) ke tombol menu */
  /* + berbentuk tab di tepi kanan, seperti tombol back dan menu di bawahnya:
     bulat di kiri, rata di sisi yang menempel ke tepi layar, termasuk saat
     hover atau ditekan */
  .fab {
    top: auto;
    right: 0;
    bottom: 5.1rem; /* 1.5rem + 2.5rem menu + 1.1rem */
  }

  .fab,
  .fab:hover,
  .fab:focus-visible,
  .fab:active {
    border-right-width: 0;
    border-radius: 999px 0 0 999px;
  }

  .fab-search {
    top: auto;
    bottom: 8rem; /* 5.1rem + 2.5rem + 0.4rem */
  }

  .search-box {
    top: auto;
    bottom: 8rem;
    right: 1.75rem;
    height: 2.5rem;
    clip-path: inset(-24px -8px -24px calc(100% - 2.5rem) round 30px);
  }

  .search-box.is-open {
    clip-path: inset(-24px -8px -24px -8px round 30px);
  }

  .search-box .search-input,
  .search-box .search-input:hover,
  .search-box .search-input:focus {
    width: calc(100% - 1.25rem);
    padding-right: 1.9rem;
  }

  .search-box:has(.search-clear) .search-input {
    padding-right: 3.6rem;
  }

  .search-clear {
    right: 3.1rem;
  }

  .search-box::before {
    border-radius: 25px 23px 23px 19px / 19px 23px 23px 25px;
  }

  @media (max-width: 959px) {
    .search-scrim {
      /* tombol search: bottom 8rem, tinggi 2.5rem, + fade 2.5rem */
      height: calc(8rem + 2.5rem + 2.5rem);
    }
  }

  @media (max-width: 639px) {
    /* 1.75rem, ikonnya ikut mengecil (0.75rem); berbentuk tab di tepi kanan
       seperti tombol back dan menu: bulat di kiri, rata di sisi yang menempel
       ke tepi layar, termasuk saat hover, ditekan, atau terbuka */
    .fab-search,
    .fab {
      right: 0;
      width: 1.75rem;
      height: 1.75rem;
      font-size: 0.75rem;
    }

    .fab-search,
    .fab-search:hover,
    .fab-search:focus-visible,
    .fab-search:active,
    .fab,
    .fab:hover,
    .fab:focus-visible,
    .fab:active {
      border-right-width: 0;
      border-radius: 999px 0 0 999px;
    }

    .fab {
      top: auto;
      bottom: 3.25rem; /* menu: bottom 0.75rem + 1.75rem + 0.75rem */
    }

    .fab-search {
      top: auto;
      bottom: 5.35rem; /* tombol +: 3.25rem + 1.75rem + 0.35rem */
    }

    /* kapsul dengan panjang secukupnya (15rem, tidak melewati gutter konten)
       sampai ke tepi layar, tempat tab search menutup ujungnya */
    .search-box {
      top: auto;
      bottom: 5.35rem;
      right: 0;
      width: min(15rem, calc(100vw - 2.5rem));
      height: 1.75rem;
      clip-path: inset(-24px -8px -24px calc(100% - 1.75rem) round 30px);
    }

    .search-box.is-open {
      clip-path: inset(-24px -8px -24px -8px round 30px);
    }

    .search-box .search-input,
    .search-box .search-input:hover,
    .search-box .search-input:focus {
      width: calc(100% - 0.875rem); /* sampai di bawah bagian tengah tombol 1.75rem */
      padding-right: 1.8rem;
    }

    /* tombol x berada dekat tab search (sekitar 6px), dan teks yang diketik
       berhenti tepat sebelum x */
    .search-box:has(.search-clear) .search-input {
      padding-right: 2.6rem;
    }

    .search-clear {
      right: 2.1rem;
    }

    /* di sini search berbentuk tab di tepi layar, jadi badge search aktif
       pindah ke sudut kiri atas (sudut kanan atas ada di luar layar) dan
       ikut mengecil bersama tombolnya */
    .search-badge {
      top: -0.35rem;
      right: auto;
      left: -0.35rem;
      min-width: 1.1rem;
      height: 1.1rem;
      padding: 0 0.2rem;
      font-size: 0.65rem;
    }

    .search-box::before {
      border-radius: 25px 21px 21px 19px / 19px 21px 21px 25px;
    }

    .search-scrim {
      height: calc(5.35rem + 1.75rem + 2.5rem);
    }
  }

  /* tablet + desktop: search tampil sebaris di baris jumlah, tepat di kiri
     switch list/card, dan selalu terlihat. Tombol search mengambang dan scrim
     ponsel tidak diperlukan di sini */
  .search-inline-icon {
    display: none;
  }

  @media (min-width: 640px) {
    .fab-search,
    .search-scrim {
      display: none;
    }

    .search-box,
    .search-box.is-open {
      position: relative;
      top: auto;
      right: auto;
      bottom: auto;
      z-index: auto;
      width: 15rem;
      height: 2.2rem;
      margin: 0 0.75rem 0 auto;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      clip-path: none;
      transform: none;
      transition: none;
    }

    .search-box::before {
      display: none;
    }

    /* jika tidak ada switch list/card di kanannya, search box menempel ke tepi */
    .search-box:last-child {
      margin-right: 0;
    }

    .search-inline-icon {
      position: absolute;
      top: 50%;
      left: 0.8rem;
      z-index: 1;
      display: inline-flex;
      font-size: 0.95rem;
      color: color-mix(in srgb, var(--color-ink-soft) 70%, var(--color-paper));
      transform: translateY(-50%);
      pointer-events: none;
    }

    /* warna kertas dan garis pena pucat yang sama dengan switch list/card di sebelahnya */
    .search-box .search-input,
    .search-box .search-input:hover,
    .search-box .search-input:focus {
      width: 100%;
      height: 100%;
      padding: 0 1rem 0 2.2rem;
      background-color: color-mix(in srgb, var(--color-paper-deep) 55%, var(--color-paper));
      border: 1.5px solid color-mix(in srgb, var(--color-ink) 14%, var(--color-line));
      border-radius: 22px 18px 24px 16px / 16px 24px 18px 22px;
      box-shadow: none;
    }

    .search-box .search-input:hover {
      border-color: color-mix(in srgb, var(--color-ink) 28%, var(--color-line));
    }

    .search-box .search-input:focus {
      background-color: var(--color-card);
      border-color: color-mix(in srgb, var(--color-ink) 40%, var(--color-line));
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-secondary) 35%, transparent);
    }

    .search-box:has(.search-clear) .search-input {
      padding-right: 2.4rem;
    }

    .search-clear {
      right: 0.85rem;
    }
  }
</style>
