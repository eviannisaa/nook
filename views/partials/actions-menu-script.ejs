<script>
  // Menu Actions: terbuka di bawah tombolnya, lalu tertutup setelah item
  // dipilih, klik di luar menu, atau Esc (focus kembali ke tombol). Tombol
  // panah berpindah antar-item
  document.querySelectorAll(".actions-menu").forEach((wrap) => {
    const btn = wrap.querySelector(".actions-menu-btn");
    const allItems = [...wrap.querySelectorAll('[role="menuitem"]')];
    // Halaman bisa menyembunyikan item sementara (PDF catatan terkunci sampai catatan dibuka)
    const shown = () => allItems.filter((item) => !item.hidden);

    function setOpen(open, focusFirst) {
      wrap.classList.toggle("is-open", open);
      btn.setAttribute("aria-expanded", String(open));
      if (open && focusFirst) shown()[0]?.focus();
    }

    btn.addEventListener("click", () => setOpen(!wrap.classList.contains("is-open")));
    btn.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setOpen(true, true);
      }
    });
    allItems.forEach((item) => {
      item.addEventListener("click", () => setOpen(false));
      item.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
        e.preventDefault();
        const items = shown();
        const i = items.indexOf(item);
        items[(i + (e.key === "ArrowDown" ? 1 : items.length - 1)) % items.length].focus();
      });
    });
    document.addEventListener("click", (e) => {
      if (!wrap.contains(e.target)) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && wrap.classList.contains("is-open")) {
        setOpen(false);
        btn.focus();
      }
    });
  });
</script>
