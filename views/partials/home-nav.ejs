<% if (user && path !== "/") { %>
<%
  const onContacts = path.startsWith("/contact");
  const onJournal = path.startsWith("/writing");
%>
<style>
  /* geometri: empat item berjarak 30° pada seperempat lingkaran di sekitar
     titik tengah tombol menu (dari atas ke kiri). --x/--y pada setiap item adalah
     nilai cos/sin-nya di busur itu, yang terbuka ke atas dari tab di pojok kanan bawah. */
  .menu-dial {
    /* layout memberi setiap anak body "position: relative; z-index: 1", yang
       membuat tombol fixed ini tertutup halaman. Karena itu, nilainya dibuat netral */
    position: static;
    z-index: auto;
    --menu-size: 2.5rem;
    --menu-right: 0rem;
    --menu-bottom: 1.5rem;
    --item-size: 2.5rem;
    --radius: 5.6rem;
  }

  /* tab di tepi kanan: bulat di sisi kiri, rata di sisi yang menempel ke
     tepi layar, dan setinggi tombol search / + (2.5rem) */
  .home-nav {
    right: var(--menu-right);
    bottom: var(--menu-bottom);
    width: var(--menu-size);
    height: var(--menu-size);
    font-size: 1.05rem;
    border-right-width: 0;
    border-radius: 999px 0 0 999px;
  }

  /* halaman (dan tombol melayang lainnya) diredupkan selama dial terbuka */
  .menu-dial-scrim {
    position: fixed;
    inset: 0;
    z-index: 45;
    background-color: color-mix(in srgb, var(--color-paper) 72%, transparent);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.35s var(--ease-smooth),
      visibility 0s linear 0.35s;
  }

  .menu-dial.is-open .menu-dial-scrim {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.35s var(--ease-smooth),
      visibility 0s;
  }

  /* menu tetap satu-satunya tombol hijau, sedikit lebih gelap saat terbuka */
  .menu-dial.is-open .home-nav {
    z-index: 50;
    background-color: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
  }

  /* ikon menu ↔ ikon close, bergantian di posisi yang sama */
  .home-nav .fab-icon {
    transition:
      opacity 0.3s var(--ease-smooth),
      transform 0.4s var(--ease-smooth);
  }

  .home-nav .dial-icon-close {
    position: absolute;
    opacity: 0;
    transform: rotate(-45deg) scale(0.6);
  }

  .menu-dial.is-open .home-nav .dial-icon-open {
    opacity: 0;
    transform: rotate(45deg) scale(0.6);
  }

  .menu-dial.is-open .home-nav .dial-icon-close {
    opacity: 1;
    transform: none;
  }

  /* item awalnya tersembunyi di belakang tombol menu, lalu menyebar di sepanjang busur */
  .dial-item {
    position: fixed;
    /* bergeser 0.5rem dari tepi agar item yang tepat di atas (atau di bawah)
       tab tidak menempel ke tepi */
    right: calc(var(--menu-right) + (var(--menu-size) - var(--item-size)) / 2 + 0.5rem);
    bottom: calc(var(--menu-bottom) + (var(--menu-size) - var(--item-size)) / 2);
    z-index: 50;
    display: inline-flex;
    width: var(--item-size);
    height: var(--item-size);
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    color: var(--color-ink);
    background-color: var(--color-card);
    border: 1.5px solid color-mix(in srgb, var(--color-ink) 50%, var(--color-line));
    border-radius: 999px;
    box-shadow: 0 8px 18px -10px rgba(0, 0, 0, 0.4);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(0, 0) scale(0.4);
    transition:
      transform 0.45s var(--ease-smooth),
      opacity 0.3s var(--ease-smooth),
      border-color 0.3s var(--ease-smooth),
      visibility 0s linear 0.45s;
  }

  button.dial-item {
    padding: 0;
    font: inherit;
    cursor: pointer;
  }

  .menu-dial.is-open .dial-item {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(calc(var(--x) * var(--radius)), calc(var(--y) * var(--radius)));
    transition:
      transform 0.45s var(--ease-smooth) var(--d),
      opacity 0.3s var(--ease-smooth) var(--d),
      border-color 0.3s var(--ease-smooth),
      visibility 0s;
  }

  /* saat menyebar, item melewati pointer yang masih berada di atas menu.
     Item baru menerima hover setelah sampai di posisinya, agar label tidak berkedip */
  .menu-dial.is-opening .dial-item {
    pointer-events: none;
  }

  .dial-item:hover,
  .dial-item:focus-visible {
    border-color: var(--color-ink);
    outline: none;
  }

  .dial-item:focus-visible {
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--color-secondary) 55%, transparent),
      0 8px 18px -10px rgba(0, 0, 0, 0.4);
  }

  /* item untuk halaman yang sedang dibuka diberi warna isi */
  .dial-item.is-current {
    color: var(--color-on-primary);
    background-color: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* label kertas kecil di atas item (di kiri untuk .is-left), hanya tampil saat hover / fokus
     keyboard (label yang selalu tampil akan saling bertabrakan di busur). Teksnya
     tetap menjadi accessible name link */
  .dial-label {
    position: absolute;
    bottom: calc(100% + 0.4rem);
    left: 50%;
    padding: 0.15rem 0.6rem;
    font-family: var(--font-comic);
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
    color: var(--color-ink);
    background-color: var(--color-card);
    border: 1.5px solid color-mix(in srgb, var(--color-ink) 35%, var(--color-line));
    border-radius: 999px;
    opacity: 0;
    transform: translate(-50%, 4px);
    pointer-events: none;
    transition:
      opacity 0.25s var(--ease-smooth),
      transform 0.3s var(--ease-smooth);
  }

  .dial-item:hover .dial-label,
  .dial-item:focus-visible .dial-label {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* Writing dan Contacts: label berada di atas item, rata dengan sisi
     kanannya dan memanjang ke kiri, agar label Writing (tepat di atas tab,
     dekat tepi layar) tidak terpotong */
  .dial-label:not(.is-left) {
    right: 0;
    left: auto;
    transform: translateY(4px);
  }

  .dial-item:hover .dial-label:not(.is-left),
  .dial-item:focus-visible .dial-label:not(.is-left) {
    transform: none;
  }

  /* Home berada di kiri tombol, sehingga labelnya diletakkan di sisi kiri,
     bukan di atas */
  .dial-label.is-left {
    right: calc(100% + 0.5rem);
    bottom: auto;
    top: 50%;
    left: auto;
    transform: translate(4px, -50%);
  }

  .dial-item:hover .dial-label.is-left,
  .dial-item:focus-visible .dial-label.is-left {
    transform: translate(0, -50%);
  }

  /* item yang di-hover/fokus tampil di atas item sebelahnya agar labelnya terlihat */
  .dial-item:hover,
  .dial-item:focus-visible {
    z-index: 51;
  }

  /* di ponsel, ukurannya mengikuti tombol melayang yang lebih kecil (1.75rem).
     Ditulis dengan CSS biasa (bukan di layer Tailwind) agar menang atas utility ukuran. */
  @media (max-width: 639px) {
    .menu-dial {
      --menu-size: 1.75rem;
      --menu-right: 0rem;
      --menu-bottom: 0.75rem;
      --item-size: 2rem;
      --radius: 4.5rem;
    }

    /* ikonnya ikut mengecil menjadi 0.9rem */
    .home-nav {
      font-size: 0.75rem;
    }

    /* tombol melayang tampil 1.75rem di sini, tetapi area sentuhnya tetap
       2.75rem (44px) lewat lingkaran tak terlihat di sekelilingnya, hingga melewati tepi layar */
    .home-nav::after,
    .fab-simple::after {
      content: "";
      position: absolute;
      inset: -0.5rem;
      border-radius: 50%;
    }

    .dial-item {
      font-size: 1rem;
    }
  }
</style>
<!-- Menu: tombol bulat di pojok kanan bawah. Saat ditekan, Writing / Contacts /
     Home / Sign out muncul menyebar dalam busur di sekelilingnya (speed dial),
     bukan langsung kembali ke halaman home. -->
<div class="menu-dial" id="menu-dial">
  <div class="menu-dial-scrim" data-dial-close aria-hidden="true"></div>

  <button
    type="button"
    class="home-nav doodle-btn doodle-btn-ink fixed right-6 bottom-6 z-40 h-12 w-12 p-0 text-xl shadow-[0_10px_24px_-10px_rgba(0,0,0,0.5)]"
    aria-expanded="false"
    aria-controls="menu-dial-items"
    aria-label="Open menu"
    title="Menu"
  >
    <%- include("doodle-icon", { name: "grid", cls: "fab-icon dial-icon-open" }) %>
    <%- include("doodle-icon", { name: "x", cls: "fab-icon dial-icon-close" }) %>
  </button>

  <nav class="menu-dial-items" id="menu-dial-items" aria-label="Main">
    <a href="/writing" class="dial-item <%= onJournal ? 'is-current' : '' %>" style="--x: 0; --y: -1; --d: 0ms"
      <%- onJournal ? 'aria-current="page"' : '' %>>
      <%- include("doodle-icon", { name: "journal" }) %>
      <span class="dial-label">Writing</span>
    </a>
    <a href="/contacts" class="dial-item <%= onContacts ? 'is-current' : '' %>" style="--x: -0.5; --y: -0.866; --d: 40ms"
      <%- onContacts ? 'aria-current="page"' : '' %>>
      <%- include("doodle-icon", { name: "people" }) %>
      <span class="dial-label">Contacts</span>
    </a>
    <a href="/" class="dial-item" style="--x: -0.866; --y: -0.5; --d: 80ms">
      <%- include("doodle-icon", { name: "home" }) %>
      <span class="dial-label is-left">Home</span>
    </a>
    <!-- sign out memakai form, agar link dari tempat lain tidak bisa membuat user logout -->
    <form action="/logout" method="post" class="contents">
      <button type="submit" class="dial-item" style="--x: -1; --y: 0; --d: 120ms" aria-label="Sign out <%= user.username %>">
        <%- include("doodle-icon", { name: "logout" }) %>
        <span class="dial-label is-left">Sign out <%= user.username %></span>
      </button>
    </form>
  </nav>
</div>

<script>
  (function () {
    const dial = document.getElementById("menu-dial");
    if (!dial) return;
    const btn = dial.querySelector(".home-nav");
    // durasi animasi menyebar: 0.45s, ditambah jeda item terakhir
    const OPENING_MS = 550;
    let openingTimer = null;
    const setOpen = (open) => {
      clearTimeout(openingTimer);
      dial.classList.toggle("is-opening", open);
      if (open) openingTimer = setTimeout(() => dial.classList.remove("is-opening"), OPENING_MS);
      dial.classList.toggle("is-open", open);
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };
    btn.addEventListener("click", () => setOpen(!dial.classList.contains("is-open")));

    // posisi menu hasil drag dari versi lama, sudah tidak dipakai sehingga dihapus
    try {
      localStorage.removeItem("menu-dial-position");
    } catch {}

    dial.querySelector("[data-dial-close]").addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && dial.classList.contains("is-open")) {
        setOpen(false);
        btn.focus();
      }
    });
  })();
</script>
<% } %>
