  <g transform="rotate(-7 100 124)">
    <circle cx="104" cy="35" r="11" fill="currentColor" />
    <path d="M72 88 C70 60 84 46 102 46 C122 46 132 62 130 88 C128 110 116 122 100 122 C84 122 74 110 72 88 Z" fill="var(--color-card)" />
