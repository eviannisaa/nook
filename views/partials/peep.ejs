<%
  // Open Peeps style line-art people. Pass `pose` ("wave", "write", "read", "call", "chat", "add", "edit", "think")
  // and optionally `cls` for sizing, e.g. include("partials/peep", { pose: "wave", cls: "h-28" })
  const peepPose = typeof pose !== "undefined" ? pose : "wave";
  const peepCls = typeof cls !== "undefined" ? cls : "h-28";
%>
<svg
  class="peep <%= peepCls %>"
  viewBox="0 0 200 200"
  fill="none"
  stroke="currentColor"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <% if (peepPose === "wave") { %>
  <!-- shirt + waving sleeve -->
  <path d="M46 199 C48 162 66 140 100 138 C134 140 150 160 154 199" fill="var(--color-marker)" />
  <path d="M136 152 C148 134 154 116 156 98 L172 100 C170 122 162 146 150 164" fill="var(--color-marker)" />
  <ellipse cx="164" cy="88" rx="10" ry="12" fill="var(--color-card)" />
  <path d="M182 72 q7 7 4 16 M150 66 q-7 5 -6 14" stroke-width="2.5" />
  <!-- neck -->
  <path d="M90 118 L90 138 M110 118 L110 138" />
  <path d="M86 139 Q100 150 114 139" />
  <!-- head -->
  <path d="M72 88 C70 60 84 46 102 46 C122 46 132 62 130 88 C128 110 116 122 100 122 C84 122 74 110 72 88 Z" fill="var(--color-card)" />
  <path d="M129 86 c8 -3 10 10 1 12" fill="var(--color-card)" />
  <path d="M68 88 C60 56 80 34 104 36 C128 38 140 58 134 86 C130 74 124 66 114 60 C106 70 90 72 78 70 C73 75 70 81 68 88 Z" fill="currentColor" />
  <circle cx="84" cy="102" r="5" fill="var(--color-blush)" stroke="none" />
  <circle cx="118" cy="102" r="5" fill="var(--color-blush)" stroke="none" />
  <circle cx="90" cy="90" r="2.6" fill="currentColor" stroke="none" />
  <circle cx="113" cy="90" r="2.6" fill="currentColor" stroke="none" />
  <path d="M85 81 q5 -3 10 0 M108 81 q5 -3 10 0" stroke-width="2.5" />
  <path d="M102 93 q-4 7 1 8" stroke-width="2.5" />
  <path d="M92 108 q10 8 20 0" />
  <% } else if (peepPose === "write") { %>
  <!-- shirt -->
  <path d="M46 199 C48 162 66 140 100 138 C134 140 150 160 154 199" fill="var(--color-mint)" />
  <!-- neck -->
  <path d="M90 118 L90 138 M110 118 L110 138" />
  <path d="M86 139 Q100 150 114 139" />
  <!-- head with bun -->
  <circle cx="102" cy="34" r="11" fill="currentColor" />
  <path d="M72 88 C70 60 84 46 102 46 C122 46 132 62 130 88 C128 110 116 122 100 122 C84 122 74 110 72 88 Z" fill="var(--color-card)" />
  <path d="M71 86 C66 58 82 42 102 42 C124 42 136 58 131 86 C126 70 116 60 102 60 C88 60 77 70 71 86 Z" fill="currentColor" />
  <circle cx="84" cy="104" r="5" fill="var(--color-blush)" stroke="none" />
  <circle cx="118" cy="104" r="5" fill="var(--color-blush)" stroke="none" />
  <path d="M86 94 q4 3 8 0 M108 94 q4 3 8 0" stroke-width="2.5" />
  <path d="M102 96 q-4 6 1 7" stroke-width="2.5" />
  <path d="M96 111 q5 3 10 0" />
  <!-- notebook + pencil -->
  <path d="M58 156 L126 146 L134 199 L66 199 Z" fill="var(--color-card)" />
