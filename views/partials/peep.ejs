  <path d="M44 199 C46 164 64 142 100 140 C136 142 154 164 156 199" fill="var(--color-marker)" />
  <path d="M86 141 Q100 163 114 141" fill="var(--color-card)" stroke-width="2.5" />
  <!-- neck -->
  <path d="M92 122 L92 143 M108 122 L108 143" />
  <!-- raised arm bringing the handset up -->
  <path d="M132 150 C148 146 160 132 161 116 L146 111 C144 124 136 134 122 142" fill="var(--color-marker)" />
