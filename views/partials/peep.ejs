  <g transform="rotate(-10 140 100)">
    <path d="M128 72 C134 64 148 66 150 76 L148 84 C142 80 136 80 132 84 Z" fill="var(--color-crayon)" />
    <path d="M144 80 C156 92 156 114 140 126 L134 120 C146 110 146 96 138 88 Z" fill="var(--color-crayon)" />
    <path d="M140 126 C136 134 124 134 120 128 L126 122 C130 125 134 124 136 120 Z" fill="var(--color-crayon)" />
