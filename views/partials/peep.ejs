  <path d="M160 150 L118 191" stroke-width="2" />
  <path d="M121 188 L114 196 L118 186 Z" fill="currentColor" stroke-width="1.6" />
  <path d="M157 147 L164 154" stroke-width="3" stroke="var(--color-blush)" />
  <ellipse cx="146" cy="166" rx="9" ry="8" fill="var(--color-card)" />
  <!-- two little "fixing it" ticks by the pencil -->
  <path d="M170 128 l4 -8 M178 136 l8 -4" stroke-width="2.5" />
  <% } else if (peepPose === "call") { %>
  <!-- same person as "write", different shirt, holding a handset -->
  <path d="M46 199 C48 162 66 140 100 138 C134 140 150 160 154 199" fill="var(--color-marker)" />
