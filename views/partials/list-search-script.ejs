<%# Tombol search yang mengambang beserta kapsulnya di halaman list (contacts,
    writing). Label tombol disimpan di data-label. %>
<script>
  // Tombol search mengambang: membuka kotak search yang tersembunyi lalu
  // memberi focus. Tekan sekali lagi (atau Esc) untuk menyembunyikannya.
  // Search tidak dihapus saat disembunyikan: selama query masih ada, tombol
  // menampilkan huruf pertama query.
  function syncSearchBadge() {
    const btn = document.querySelector(".fab-search");
    const box = document.getElementById("search-box");
    const query = document.getElementById("search").value.trim();
    const label = btn.dataset.label || "Search";
    const hiddenWithQuery = !!query && !box.classList.contains("is-open");
    btn.querySelector(".search-badge").textContent = query ? query.charAt(0).toUpperCase() : "";
    btn.classList.toggle("has-query", hiddenWithQuery);
    btn.setAttribute(
      "aria-label",
      box.classList.contains("is-open")
        ? "Hide search"
        : hiddenWithQuery
          ? `${label} (active search: "${query}")`
          : label
    );
    btn.title = box.classList.contains("is-open") ? "Hide search" : label;
  }

  function openSearch() {
    const box = document.getElementById("search-box");
    const input = document.getElementById("search");
    box.classList.add("is-open");
    document.querySelector(".fab-search").setAttribute("aria-expanded", "true");
    syncSearchBadge();
    // Kotak muncul mengambang di samping tombol, jadi halaman tidak perlu scroll dan tidak ada yang bergeser
    input.focus({ preventScroll: true });
  }

  function closeSearch({ focusButton = true } = {}) {
    document.getElementById("search-box").classList.remove("is-open");
    const btn = document.querySelector(".fab-search");
    btn.setAttribute("aria-expanded", "false");
    syncSearchBadge();
    if (focusButton) btn.focus({ preventScroll: true });
  }

  syncSearchBadge();

  // Buka ↔ tutup; kotak yang sedang terbuka selalu ditutup, meskipun berisi query
  function toggleSearch() {
    const box = document.getElementById("search-box");
    if (box.classList.contains("is-open")) closeSearch();
    else openSearch();
  }
</script>
