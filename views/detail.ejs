<div class="py-8">
  <div class="m-auto grid w-[50%] grid-cols-1 gap-6">
    <div>
      <button
        class="flex cursor-pointer items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-3 py-0.5 text-sm font-medium text-neutral-800 shadow-2xs transition duration-200 ease-in-out hover:bg-neutral-100"
        onclick="window.location.href = '/'"
      >
        <i class="bi bi-arrow-left-short text-2xl"></i>
        Back to Contacts
      </button>
    </div>

    <div
      class="grid grid-cols-1 gap-12 rounded-xl border border-neutral-200 p-6 shadow"
    >
      <div>
        <div class="flex items-start justify-between">
          <div>
            <% if (contact.image) { %>
            <img
              src="<%= contact.image %>"
              class="mb-2 h-36 w-36 rounded-xl object-cover shadow"
            />
            <% } else { %>
            <i
              id="default-avatar"
              class="bi bi-person-fill mb-2 flex h-36 w-36 items-center justify-center rounded-md bg-neutral-300/50 text-8xl text-neutral-600/50"
            ></i>
            <% } %>
            <div class="flex items-center gap-2">
              <p class="text-3xl font-medium"><%= contact.name %></p>
              <p class="mt-1 text-lg text-neutral-500">|</p>
              <p class="mt-2 text-lg text-neutral-500">
                <%= contact.company ? contact.company : '-' %>
              </p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button
              class="cursor-pointer rounded-md bg-neutral-950 px-3 py-1.5 text-sm text-white transition duration-200 ease-in-out hover:bg-neutral-800"
              onclick="
                window.location.href = '/contact/edit/<%= contact._id %>'
              "
            >
              <i class="bi bi-pencil mr-1"></i>
              Edit
            </button>
            <button
              type="button"
              class="cursor-pointer rounded-md bg-red-600 px-3 py-1.5 text-sm text-white transition duration-200 ease-in-out hover:bg-red-500"
              onclick="openDeleteModal('<%= contact._id %>')"
            >
              <i class="bi bi-trash mr-1"></i>
              Delete
            </button>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-6">
        <div class="flex items-center gap-3.5">
          <i
            class="bi bi-envelope rounded-xl bg-neutral-200 px-3 py-1.25 text-lg shadow-2xs"
          ></i>
          <div class="flex flex-col gap-1.5">
            <span class="text-sm text-neutral-500">Email</span>
            <span class="text-sm"><%= contact.email %></span>
          </div>
        </div>
        <div class="flex items-center gap-3.5">
          <i
            class="bi bi-telephone rounded-xl bg-neutral-200 px-3 py-1.25 text-lg shadow-2xs"
          ></i>
          <div class="flex flex-col gap-1.5">
            <span class="text-sm text-neutral-500">Phone</span>
            <span class="text-sm"><%= contact.phone %></span>
          </div>
        </div>
        <div class="flex items-center gap-3.5">
          <i
            class="bi bi-buildings rounded-xl bg-neutral-200 px-3 py-1.25 text-lg shadow-2xs"
          ></i>
          <div class="flex flex-col gap-1.5">
            <span class="text-sm text-neutral-500">Company</span>
            <span class="text-sm">
              <%= contact.company ? contact.company : '-' %>
            </span>
          </div>
        </div>
      </div>

      <div class="border-t border-neutral-300"></div>

      <div class="flex flex-col gap-1.5">
        <span class="text-lg font-medium">Notes</span>
        <span class="text-sm"> <%= contact.notes ? contact.notes : '-' %></span>
      </div>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div
    id="delete-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80"
  >
    <div class="w-87.5 rounded-lg bg-white p-6 shadow-lg">
      <h2 class="mb-2 text-lg font-semibold">Delete Contact</h2>
      <p class="text-sm text-neutral-600">
        Are you sure you want to delete this contact?
      </p>

      <div class="mt-6 flex justify-end gap-3">
        <button
          onclick="closeDeleteModal()"
          class="ransition cursor-pointer rounded-md border border-neutral-300 px-3 py-1.5 text-sm duration-200 ease-in-out hover:bg-neutral-100"
        >
          Cancel
        </button>

        <form id="delete-form" action="/contact?_method=DELETE" method="post">
          <input
            id="delete-name"
            type="hidden"
            name="_id"
            value="<%= contact._id %>"
          />
          <input type="hidden" name="name" value="<%= contact.name %>" />
          <button
            type="submit"
            class="ransition cursor-pointer rounded-md bg-red-600 px-3 py-1.5 text-sm text-white duration-200 ease-in-out hover:bg-red-500"
          >
            Delete
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById("delete-modal");
  const deleteName = document.getElementById("delete-name");

  function openDeleteModal(name) {
    deleteName.value = name;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
  }

  function closeDeleteModal() {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
  }
</script>
