<%
  const initials = (name) =>
    (name || "").trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join("").toUpperCase();
  // digits (and a leading +) only, for the tel: link
  const telHref = "tel:" + String(contact.phone || "").replace(/[^\d+]/g, "");
%>
<%- include("partials/detail-styles") %>
<%- include("partials/actions-menu-styles") %>
<style>
  /* contact detail: same language as /contacts and /contact/new — the
     phone number is the focal point, with call + copy beside it */
  .detail-phone {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .detail-phone-num {
    position: relative;
    isolation: isolate;
    display: inline-block;
    margin-top: 0.15rem;
    padding: 0 0.3rem;
    margin-left: -0.3rem;
    font-family: var(--font-comic);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--color-ink);
    word-break: break-all;
  }

  .detail-phone-num::before {
    content: "";
    position: absolute;
    inset: auto 0 0.12em 0;
    z-index: -1;
    height: 0.45em;
    background: linear-gradient(
      100deg,
      transparent 1%,
      color-mix(in srgb, var(--color-marker) 34%, transparent) 4%,
      color-mix(in srgb, var(--color-marker) 26%, transparent) 95%,
      transparent 99%
    );
    border-radius: 3px 10px 4px 12px;
    transform: rotate(-0.8deg);
  }

  .detail-phone-actions {
    display: flex;
    gap: 0.5rem;
  }

  .detail-notes {
    font-family: var(--font-comic);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink);
    white-space: pre-line;
  }

  /* when the contact was added and last edited, quiet lines at the card's top */
  .detail-stamps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1.25rem;
    font-family: var(--font-comic);
    font-size: 0.8rem;
    color: var(--color-ink-soft);
  }

  /* floats under the copy button so it never adds space to the card */
  .copied-note {
    position: absolute;
    top: calc(100% + 0.35rem);
    right: 0;
    font-family: var(--font-comic);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-crayon);
    opacity: 0;
    transition: opacity 0.3s var(--ease-smooth);
  }

  .copied-note.is-shown {
    opacity: 1;
  }

  @media (max-width: 639px) {
    .detail-phone-num {
      font-size: 1.15rem;
    }

    .detail-notes {
      font-size: 0.85rem;
    }

    .copied-note {
      font-size: 0.75rem;
    }

    .detail-stamps {
      flex-direction: column;
      font-size: 0.7rem;
    }
  }
</style>

<div class="detail-page mx-auto grid w-full max-w-2xl grid-cols-1 gap-6 p-6 pt-14">
  <!-- floating back button, just above the menu button -->
  <a
    href="/contacts"
    aria-label="Back to contacts"
    title="Back to contacts"
    class="fab-back fab-simple doodle-btn fixed right-6 z-40 h-12 w-12 p-0 text-xl"
  >
    <%- include("partials/doodle-icon", { name: "arrow-left", cls: "fab-icon" }) %>
  </a>

  <!-- hero -->
  <div class="detail-hero header" data-stagger style="--i: 0">
    <div class="detail-hero-main">
    <span class="detail-avatar-wrap">
      <span class="detail-avatar">
        <% if (contact.image) { %>
        <img src="<%= contact.image %>" alt="" />
        <% } else { %>
        <%= initials(contact.name) %>
        <% } %>
      </span>
    </span>
    <div class="min-w-0">
      <h2 class="header-title detail-name">
        <span class="header-title-mark"><%= contact.name %></span>
      </h2>
      <p class="detail-caption"><%= contact.company ? contact.company : "No company" %></p>
      <% if (access !== "owner") { %>
      <p class="detail-shared">
        <%- include("partials/doodle-icon", { name: "share" }) %>
        Shared by <%= contact.owner.username %> · <%= access === "edit" ? "you can edit" : "view only" %>
      </p>
      <% } %>
    </div>
    </div>

    <!-- the contact's actions, on the same line as the name
         (space-between), as on a note: edit · delete (or, when it's
         shared with this account, taking it off this account) -->
    <div class="detail-actions">
      <div class="actions-menu">
        <button type="button" class="header-link actions-menu-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="contact-actions-menu">
          Actions
          <span class="actions-menu-chevron" aria-hidden="true"><%- include("partials/doodle-icon", { name: "chevron-right" }) %></span>
        </button>
        <div class="actions-menu-list" id="contact-actions-menu" role="menu" aria-label="Contact actions">
          <% if (access !== "view") { %>
          <a href="/contact/edit/<%= contact._id %>" role="menuitem">
            <%- include("partials/doodle-icon", { name: "pencil" }) %>
            Edit
          </a>
          <% } %>
          <% if (access === "owner") { %>
          <button type="button" role="menuitem" onclick="openModal(document.getElementById('share-modal'))">
            <%- include("partials/doodle-icon", { name: "share" }) %>
            Share
          </button>
          <span class="actions-menu-sep" role="separator"></span>
          <button type="button" role="menuitem" class="is-danger" onclick="openDeleteModal()">
            <%- include("partials/doodle-icon", { name: "trash" }) %>
            Delete
          </button>
          <% } else { %>
          <% if (access === "edit") { %>
          <span class="actions-menu-sep" role="separator"></span>
          <% } %>
          <button type="button" role="menuitem" class="is-danger" onclick="openDeleteModal()">
            <%- include("partials/doodle-icon", { name: "trash" }) %>
            Remove from my list
          </button>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- card -->
  <div class="detail-card grid grid-cols-1 gap-6 p-6 sm:p-8" data-stagger style="--i: 1">
    <%
      // a contact saved before timestamps were kept: its id still holds when
      // it was made; edited only once saved again after that
      const created = contact.createdAt || contact._id.getTimestamp();
      const edited =
        contact.updatedAt && contact.updatedAt - created > 1000 ? contact.updatedAt : null;
    %>
    <div class="detail-stamps">
      <span>Created <%= formatDate(created) %></span>
      <% if (edited) { %>
      <span>Edited <%= formatDate(edited) %></span>
      <% } %>
    </div>

    <div class="detail-divider"></div>

    <div class="detail-phone">
      <div class="min-w-0">
        <span class="detail-label">Phone</span>
        <div><span class="detail-phone-num" id="phone-num"><%= contact.phone %></span></div>
      </div>
      <div class="detail-phone-actions">
        <a href="<%= telHref %>" class="quiet-btn is-primary">
          <%- include("partials/doodle-icon", { name: "phone" }) %>
          Call
        </a>
        <button type="button" class="quiet-btn" id="copy-phone">
          <%- include("partials/doodle-icon", { name: "copy" }) %>
          <span>Copy</span>
        </button>
      </div>
      <span class="copied-note" id="copied-note" role="status" aria-live="polite"></span>
    </div>

    <div class="detail-divider"></div>

    <div class="detail-rows">
      <div class="detail-row">
        <span class="detail-row-icon" style="--icon-bg: var(--color-blush)">
          <%- include("partials/doodle-icon", { name: "mail" }) %>
        </span>
        <div class="min-w-0">
          <span class="detail-label">Email</span>
          <% if (contact.email) { %>
          <a href="mailto:<%= contact.email %>" class="detail-row-value"><%= contact.email %></a>
          <% } else { %>
          <span class="detail-row-value detail-empty">—</span>
          <% } %>
        </div>
      </div>

      <div class="detail-row">
        <span class="detail-row-icon" style="--icon-bg: var(--color-mint)">
          <%- include("partials/doodle-icon", { name: "building" }) %>
        </span>
        <div class="min-w-0">
          <span class="detail-label">Company</span>
          <span class="detail-row-value <%= contact.company ? '' : 'detail-empty' %>">
            <%= contact.company ? contact.company : "—" %>
          </span>
        </div>
      </div>
    </div>

    <div class="detail-divider"></div>

    <div class="flex flex-col gap-2">
      <span class="detail-label inline-flex items-center gap-1.5">
        <%- include("partials/doodle-icon", { name: "note" }) %>
        Notes
      </span>
      <p class="detail-notes <%= contact.notes ? '' : 'detail-empty' %>"><%= contact.notes ? contact.notes : "No notes yet." %></p>
    </div>

  </div>

  <% if (access === "owner") { %>
  <%- include("partials/share-modal", { base: "/contact/" + contact._id, noun: "contact", shares }) %>

  <!-- delete confirmation -->
  <div id="delete-modal" class="doodle-modal">
    <div class="delete-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-title">
      <h2 id="delete-title" class="mb-1 text-2xl">Delete contact?</h2>
      <p class="text-ink-soft font-comic font-bold">
        <%= contact.name %> will be removed from your list.
      </p>

      <div class="mt-6 flex items-center justify-end gap-2">
        <button type="button" onclick="closeDeleteModal()" class="delete-link">Cancel</button>
        <form id="delete-form" action="/contact?_method=DELETE" method="post">
          <input type="hidden" name="_id" value="<%= contact._id %>" />
          <button type="submit" class="doodle-btn doodle-btn-sm doodle-btn-danger">
            Yes
          </button>
        </form>
      </div>
    </div>
  </div>
  <% } else { %>
  <!-- shared with this account: taken off it only, the owner keeps it -->
  <div id="delete-modal" class="doodle-modal">
    <div class="delete-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-title">
      <h2 id="delete-title" class="mb-1 text-2xl">Remove contact?</h2>
      <p class="text-ink-soft font-comic font-bold">
        <%= contact.name %> will be removed from your list. <%= contact.owner.username %> still keeps it.
      </p>

      <div class="mt-6 flex items-center justify-end gap-2">
        <button type="button" onclick="closeDeleteModal()" class="delete-link">Cancel</button>
        <form id="delete-form" action="/contact/<%= contact._id %>/shares/<%= user._id %>?_method=DELETE" method="post">
          <button type="submit" class="doodle-btn doodle-btn-sm doodle-btn-danger">
            Yes
          </button>
        </form>
      </div>
    </div>
  </div>
  <% } %>
</div>

<%- include("partials/actions-menu-script") %>

<script>
  const modal = document.getElementById("delete-modal");

  function openDeleteModal() {
    openModal(modal);
  }

  function closeDeleteModal() {
    closeModal(modal);
  }

  // copy the phone number, with a short "Copied" note
  (function () {
    const btn = document.getElementById("copy-phone");
    const note = document.getElementById("copied-note");
    const number = document.getElementById("phone-num").textContent.trim();
    let timer = null;
    btn.addEventListener("click", async () => {
      // modern clipboard first, then the classic select + copy fallback
      let ok = false;
      try {
        await navigator.clipboard.writeText(number);
        ok = true;
      } catch (e) {
        const ta = document.createElement("textarea");
        ta.value = number;
        ta.setAttribute("readonly", "");
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        try {
          ok = document.execCommand("copy");
        } catch (err) {}
        ta.remove();
      }
      note.textContent = ok ? "Copied to clipboard" : "Couldn't copy, select the number instead";
      note.classList.add("is-shown");
      clearTimeout(timer);
      timer = setTimeout(() => note.classList.remove("is-shown"), 1800);
    });
  })();
</script>
